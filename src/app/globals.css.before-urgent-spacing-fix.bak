/* =========================================================
   DF HERO ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â PLAYFUL MAGIC LAMP / ADVERTISING BANNER REVEAL
   ========================================================= */

.genie-scene {
  position: relative;
  isolation: isolate;
  width: 100%;
  max-width: 570px;
  min-height: 470px;
  margin-inline: auto;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 30px;
  background:
    radial-gradient(ellipse at 53% 52%, rgb(54 93 155 / 23%), transparent 48%),
    linear-gradient(145deg, rgb(16 29 54 / 35%), rgb(9 15 30 / 8%));
}

.genie-scene__glow {
  position: absolute;
  width: 72%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgb(72 218 218 / 15%), rgb(124 83 255 / 8%) 42%, transparent 72%);
  filter: blur(12px);
  animation: genie-glow-pulse 5s ease-in-out infinite alternate;
}

.genie-banner {
  position: absolute;
  z-index: 3;
  top: 12%;
  left: 7%;
  width: 86%;
  padding: clamp(17px, 3vw, 25px);
  border: 1px solid rgb(121 225 231 / 42%);
  border-radius: 19px;
  background: linear-gradient(135deg, rgb(19 35 64 / 96%), rgb(28 34 78 / 94%));
  box-shadow: 0 24px 65px rgb(0 0 0 / 26%), inset 0 1px rgb(255 255 255 / 10%);
  opacity: 0;
  transform: translate3d(0, 28px, 0) scale(.91);
  animation: genie-banner-reveal 1s cubic-bezier(.2,.75,.25,1) 1.35s forwards;
}

.genie-banner__topline,
.genie-banner__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: #79e7df;
  font-size: .62rem;
  font-weight: 800;
  letter-spacing: .12em;
}

.genie-banner__spark {
  color: #ffd16b;
  font-size: 1.1rem;
}

.genie-banner__status {
  padding: 6px 8px;
  border: 1px solid rgb(121 231 223 / 28%);
  border-radius: 99px;
  font-size: .53rem;
  letter-spacing: .06em;
}

.genie-banner h2 {
  margin: 17px 0 10px;
  color: #fff;
  font-size: clamp(1.55rem, 3.2vw, 2.35rem);
  line-height: 1.06;
  font-weight: 800;
  letter-spacing: -.055em;
}

.genie-banner h2 span {
  display: block;
  margin-top: 4px;
  color: #79e7df;
}

.genie-banner p {
  margin: 0 0 19px;
  color: #c5d1e6;
  font-size: clamp(.78rem, 1.2vw, .9rem);
  line-height: 1.6;
}

.genie-banner__footer {
  padding-top: 12px;
  border-top: 1px solid rgb(255 255 255 / 12%);
  color: #fff;
  font-size: .58rem;
}

.genie-banner__arrow {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border-radius: 50%;
  background: #6de0d4;
  color: #10233b;
  font-size: 1rem;
}

.genie-smoke {
  position: absolute;
  z-index: 2;
  inset: 0;
  pointer-events: none;
}

.genie-smoke__puff {
  position: absolute;
  display: block;
  width: 100px;
  height: 100px;
  border-radius: 48% 52% 62% 38%;
  opacity: 0;
  filter: blur(12px);
  mix-blend-mode: screen;
  animation: genie-puff-rise 3.8s ease-out infinite;
}

.genie-smoke__puff--one {
  left: 42%;
  top: 48%;
  background: radial-gradient(circle at 35% 35%, rgb(100 246 224 / 86%), rgb(35 194 221 / 38%) 45%, transparent 72%);
  animation-delay: .1s;
}

.genie-smoke__puff--two {
  left: 54%;
  top: 40%;
  background: radial-gradient(circle, rgb(180 117 255 / 78%), rgb(117 83 255 / 34%) 48%, transparent 72%);
  animation-delay: .65s;
}

.genie-smoke__puff--three {
  left: 30%;
  top: 39%;
  background: radial-gradient(circle, rgb(255 199 100 / 82%), rgb(255 137 94 / 28%) 48%, transparent 72%);
  animation-delay: 1.15s;
}

.genie-smoke__puff--four {
  left: 48%;
  top: 29%;
  background: radial-gradient(circle, rgb(88 224 226 / 72%), rgb(79 129 255 / 28%) 48%, transparent 72%);
  animation-delay: 1.7s;
}

.genie-smoke__puff--five {
  left: 34%;
  top: 22%;
  background: radial-gradient(circle, rgb(173 112 255 / 68%), rgb(111 99 255 / 24%) 48%, transparent 72%);
  animation-delay: 2.2s;
}

.genie-smoke__ribbon {
  position: absolute;
  width: 120px;
  height: 180px;
  border: 3px solid transparent;
  border-left-color: rgb(89 236 222 / 66%);
  border-radius: 50%;
  opacity: 0;
  filter: blur(2px);
  transform: rotate(32deg);
  animation: genie-ribbon-flow 4.2s ease-in-out infinite;
}

.genie-smoke__ribbon--one {
  left: 35%;
  top: 29%;
}

.genie-smoke__ribbon--two {
  left: 49%;
  top: 23%;
  border-left-color: rgb(174 124 255 / 70%);
  animation-delay: .8s;
}

.genie-lamp {
  position: absolute;
  z-index: 4;
  right: 3%;
  bottom: 5%;
  width: min(65%, 330px);
  animation: genie-lamp-float 4s ease-in-out infinite;
}

.genie-lamp svg {
  display: block;
  width: 100%;
  overflow: visible;
  filter: drop-shadow(0 16px 17px rgb(0 0 0 / 25%));
}

.genie-lamp__aura {
  position: absolute;
  inset: 22% 12%;
  z-index: -1;
  border-radius: 50%;
  background: rgb(255 187 74 / 22%);
  filter: blur(27px);
}

.genie-scene__particles {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.genie-particle {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #ffe49a;
  box-shadow: 0 0 12px 3px rgb(255 207 111 / 45%);
  animation: genie-twinkle 2.4s ease-in-out infinite alternate;
}

.genie-particle--1 { left: 16%; top: 23%; animation-delay: .1s; }
.genie-particle--2 { left: 77%; top: 21%; animation-delay: .8s; }
.genie-particle--3 { left: 20%; top: 57%; animation-delay: 1.2s; }
.genie-particle--4 { left: 83%; top: 57%; animation-delay: .5s; }
.genie-particle--5 { left: 32%; top: 17%; animation-delay: 1.5s; }
.genie-particle--6 { left: 70%; top: 68%; animation-delay: .3s; }
.genie-particle--7 { left: 12%; top: 42%; animation-delay: 1.1s; }
.genie-particle--8 { left: 88%; top: 37%; animation-delay: .7s; }
.genie-particle--9 { left: 57%; top: 76%; animation-delay: 1.7s; }
.genie-particle--10 { left: 27%; top: 70%; animation-delay: .4s; }
.genie-particle--11 { left: 66%; top: 14%; animation-delay: 1.3s; }
.genie-particle--12 { left: 45%; top: 18%; animation-delay: .9s; }

.genie-scene__caption {
  position: absolute;
  z-index: 5;
  left: 7%;
  bottom: 6%;
  display: flex;
  align-items: center;
  gap: 9px;
  color: #b9cbe1;
  font-size: .58rem;
  font-weight: 800;
  letter-spacing: .12em;
}

.genie-scene__caption-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #70e4d7;
  box-shadow: 0 0 12px rgb(112 228 215 / 70%);
}

@keyframes genie-banner-reveal {
  0% { opacity: 0; transform: translate3d(0, 28px, 0) scale(.91); }
  70% { opacity: 1; transform: translate3d(0, -4px, 0) scale(1.015); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes genie-puff-rise {
  0% { opacity: 0; transform: translate3d(10px, 45px, 0) scale(.35) rotate(-12deg); }
  22% { opacity: .8; }
  75% { opacity: .45; }
  100% { opacity: 0; transform: translate3d(-28px, -115px, 0) scale(1.5) rotate(22deg); }
}

@keyframes genie-ribbon-flow {
  0% { opacity: 0; transform: translate3d(10px, 55px, 0) rotate(32deg) scale(.7); }
  35% { opacity: .8; }
  75% { opacity: .4; transform: translate3d(-8px, -20px, 0) rotate(65deg) scale(1.1); }
  100% { opacity: 0; transform: translate3d(20px, -90px, 0) rotate(90deg) scale(.75); }
}

@keyframes genie-lamp-float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-11px) rotate(2deg); }
}

@keyframes genie-glow-pulse {
  from { opacity: .55; transform: scale(.92); }
  to { opacity: 1; transform: scale(1.08); }
}

@keyframes genie-twinkle {
  from { opacity: .25; transform: scale(.65); }
  to { opacity: 1; transform: scale(1.25); }
}

@media (max-width: 1000px) {
  .genie-scene { min-height: 420px; }
  .genie-banner { top: 10%; }
}

@media (max-width: 700px) {
  .genie-scene {
    min-height: 390px;
    max-width: 440px;
    border-radius: 22px;
  }

  .genie-banner {
    top: 8%;
    left: 5%;
    width: 90%;
    padding: 17px;
  }

  .genie-banner h2 { font-size: clamp(1.45rem, 6vw, 2rem); }
  .genie-lamp { right: 0; bottom: 7%; width: 70%; }
  .genie-scene__caption { left: 5%; bottom: 5%; font-size: .5rem; }
}

@media (prefers-reduced-motion: reduce) {
  .genie-scene *,
  .genie-scene *::before,
  .genie-scene *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
  }

  .genie-banner {
    opacity: 1;
    transform: none;
  }

  .genie-smoke__puff,
  .genie-smoke__ribbon { opacity: .35; }
}
@media (prefers-reduced-motion: reduce) {
  .genie-popup,
  .genie-popup__lamp,
  .genie-popup__smoke span {
    animation: none !important;
  }

  .genie-popup { opacity: 1; transform: none; }
}

/* Centered genie promotion modal with animated neon border */
.genie-popup-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9998;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgb(5 11 25 / 68%);
  backdrop-filter: blur(9px);
  -webkit-backdrop-filter: blur(9px);
  animation: genie-backdrop-in .35s ease both;
}

.genie-popup {
  position: relative;
  z-index: 9999;
  width: min(520px, calc(100vw - 32px));
  min-height: 290px;
  padding: 32px 30px 28px;
  isolation: isolate;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 24px;
  color: #fff;
  background:
    linear-gradient(145deg, #172a49, #10172e 75%) padding-box,
    conic-gradient(from var(--genie-border-angle, 0deg),
      #5be9dc, #7b61ff, #f1b7ff, #58c9ff, #5be9dc) border-box;
  box-shadow:
    0 0 0 1px rgb(91 233 220 / 20%),
    0 0 24px rgb(91 233 220 / 28%),
    0 0 60px rgb(123 97 255 / 28%),
    0 28px 100px rgb(0 0 0 / 45%);
  animation: genie-popup-enter .65s cubic-bezier(.2,.8,.2,1) both,
    genie-border-glow 5s linear infinite;
}

.genie-popup::before {
  position: absolute;
  z-index: -1;
  inset: -2px;
  border-radius: inherit;
  background: conic-gradient(from var(--genie-border-angle, 0deg),
    transparent 0deg, rgb(91 233 220 / 60%) 70deg,
    transparent 145deg, rgb(154 113 255 / 65%) 240deg,
    transparent 320deg);
  filter: blur(18px);
  opacity: .8;
  content: "";
  animation: genie-border-glow 5s linear infinite;
  pointer-events: none;
}

.genie-popup__close {
  position: absolute;
  z-index: 10;
  top: 12px;
  right: 12px;
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 1px solid rgb(255 255 255 / 25%);
  border-radius: 50%;
  background: rgb(255 255 255 / 9%);
  color: #fff;
  font-size: 23px;
  line-height: 1;
  cursor: pointer;
}

.genie-popup__content {
  position: relative;
  z-index: 3;
  max-width: 350px;
}

.genie-popup__eyebrow {
  color: #78e6dc;
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .13em;
}

.genie-popup h2 {
  margin: 18px 0 10px;
  color: #fff;
  font-size: clamp(2rem, 4vw, 2.65rem);
  line-height: 1.04;
  letter-spacing: -.05em;
  font-weight: 800;
}

.genie-popup h2 span {
  display: block;
  color: #79e7df;
}

.genie-popup p {
  max-width: 310px;
  margin: 0 0 20px;
  color: #c4d0e4;
  font-size: .94rem;
  line-height: 1.65;
}

.genie-popup__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  min-height: 45px;
  padding: 0 18px;
  border: 1px solid rgb(255 255 255 / 16%);
  border-radius: 99px;
  background: #52d8ca;
  color: #10243a;
  font-size: .82rem;
  font-weight: 800;
  text-decoration: none;
  box-shadow: 0 0 22px rgb(82 216 202 / 24%);
  transition: transform .2s ease, background .2s ease;
}

.genie-popup__cta:hover {
  transform: translateY(-2px);
  background: #8af0e4;
}

.genie-popup__lamp {
  position: absolute;
  z-index: 2;
  right: -2%;
  bottom: 2%;
  width: 42%;
  pointer-events: none;
  animation: genie-popup-lamp-float 3.6s ease-in-out infinite;
}

.genie-popup__lamp svg {
  display: block;
  width: 100%;
  overflow: visible;
  filter: drop-shadow(0 8px 18px rgb(0 0 0 / 25%));
}

.genie-popup__smoke {
  position: absolute;
  z-index: 1;
  right: 5%;
  bottom: 16%;
  width: 42%;
  height: 65%;
  pointer-events: none;
}

.genie-popup__smoke span {
  position: absolute;
  bottom: 8%;
  width: 54px;
  height: 68px;
  border-radius: 50%;
  opacity: 0;
  filter: blur(12px);
  background: #54e6d9;
  animation: genie-popup-smoke 2.8s ease-out infinite;
}

.genie-popup__smoke span:nth-child(2) {
  left: 30%;
  background: #9d79ff;
  animation-delay: .7s;
}

.genie-popup__smoke span:nth-child(3) {
  left: 55%;
  background: #ffbd66;
  animation-delay: 1.4s;
}

@keyframes genie-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes genie-popup-enter {
  from { opacity: 0; transform: translateY(22px) scale(.94); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes genie-border-glow {
  0% { --genie-border-angle: 0deg; }
  100% { --genie-border-angle: 360deg; }
}

@property --genie-border-angle {
  syntax: "<angle>";
  inherits: false;
  initial-value: 0deg;
}

@keyframes genie-popup-lamp-float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-7px) rotate(2deg); }
}

@keyframes genie-popup-smoke {
  0% { opacity: 0; transform: translateY(10px) scale(.5); }
  30% { opacity: .55; }
  100% { opacity: 0; transform: translateY(-65px) scale(1.5); }
}

@media (max-width: 520px) {
  .genie-popup-backdrop { padding: 16px; }
  .genie-popup {
    width: 100%;
    min-height: 260px;
    padding: 28px 19px 22px;
  }
  .genie-popup__content { max-width: 75%; }
  .genie-popup h2 { font-size: clamp(1.65rem, 7vw, 2rem); }
  .genie-popup p { font-size: .8rem; }
  .genie-popup__lamp { right: -7%; width: 39%; }
  .genie-popup__cta { gap: 8px; font-size: .72rem; padding-inline: 12px; }
}

@media (prefers-reduced-motion: reduce) {
  .genie-popup-backdrop,
  .genie-popup,
  .genie-popup::before,
  .genie-popup__lamp,
  .genie-popup__smoke span {
    animation: none !important;
  }
}
/* Final viewport-centred advertisement modal */
.genie-popup-backdrop {
  position: fixed !important;
  inset: 0 !important;
  z-index: 2147483000 !important;
