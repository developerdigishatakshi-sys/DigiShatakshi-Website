/* Side images fade with their existing sticky service card */
.services-section .crystal-service__side-images {
  opacity: 1;
  transition: opacity 300ms ease;
}

/* Incoming sticky service card covers the previous card and its images */
.services-section .crystal-service:nth-child(n + 2) {
  isolation: isolate;
}

@media (prefers-reduced-motion: reduce) {
  .services-section .crystal-service__side-images {
    transition: none;
  }
}

