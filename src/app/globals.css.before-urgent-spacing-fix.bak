    font-size: .88rem !important;
  }
}

/* FINAL TUNE ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â TRANSPARENT OUTER AREA, DARK INTERIOR ONLY */
.services-section .crystal-service__visual {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

.services-section .crystal-service__visual::before {
  inset: 16% !important;
  background: radial-gradient(
    circle at 50% 45%,
    #21163f 0%,
    #120b28 72%,
    #090511 100%
  ) !important;
  box-shadow: inset 0 0 32px rgba(139, 92, 246, .14) !important;
}

/* Keep all copy inside the inner circle. */
.services-section .crystal-service__content {
  left: 50% !important;
  top: 50% !important;
  right: auto !important;
  bottom: auto !important;
  width: 62% !important;
  max-width: 360px !important;
  height: auto !important;
  padding: 12px !important;
  transform: translate(-50%, -50%) !important;
}

.services-section .crystal-service__title {
  max-width: 100% !important;
  font-size: clamp(1.2rem, 2vw, 1.75rem) !important;
  line-height: 1.18 !important;
}

.services-section .crystal-service__description {
  max-width: 100% !important;
  font-size: .88rem !important;
  line-height: 1.5 !important;
}

@media (max-width: 700px) {
  .services-section .crystal-service__content {
    width: 68% !important;
    max-width: 300px !important;
  }
}

/* CRYSTAL SERVICE STICKY SCROLL STACKING ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â REVISED */
.services-section {
  position: relative;
  isolation: isolate;
}

.services-section > .container {
  overflow: visible !important;
}

.services-section .crystal-services-grid {
  position: relative !important;
  display: block !important;
  overflow: visible !important;
  padding-bottom: 2px;
}

.services-section .crystal-services-grid > .crystal-service {
  position: sticky !important;
  top: 108px !important;
  display: grid !important;
  width: 100% !important;
  min-height: clamp(520px, 68vw, 720px) !important;
  margin: 0 0 8vh !important;
  background: transparent !important;
  overflow: visible !important;
  transform: none !important;
}

/* Later spheres cover earlier spheres. */
.services-section .crystal-services-grid > .crystal-service:nth-child(1) { z-index: 1; }
.services-section .crystal-services-grid > .crystal-service:nth-child(2) { z-index: 2; }
.services-section .crystal-services-grid > .crystal-service:nth-child(3) { z-index: 3; }
.services-section .crystal-services-grid > .crystal-service:nth-child(4) { z-index: 4; }
.services-section .crystal-services-grid > .crystal-service:nth-child(5) { z-index: 5; }
.services-section .crystal-services-grid > .crystal-service:nth-child(6) { z-index: 6; }
.services-section .crystal-services-grid > .crystal-service:nth-child(7) {
  z-index: 7;
  margin-bottom: 0 !important;
}

@media (max-width: 700px) {
  .services-section .crystal-services-grid > .crystal-service {
    top: 84px !important;
    min-height: 480px !important;
    margin-bottom: 6vh !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .services-section .crystal-services-grid > .crystal-service {
    position: relative !important;
    top: auto !important;
    margin-bottom: 24px !important;
  }
}

/* SOFT PREMIUM COLORS ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â WHY BUSINESS CHOOSE US */
.why-section .why-grid > .why-card:nth-child(3n + 1) {
  background: #EAE8FA !important;
  border: 1px solid #D3CEF6 !important;
}

.why-section .why-grid > .why-card:nth-child(3n + 2) {
