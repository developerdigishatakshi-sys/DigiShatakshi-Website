/* HERO HEADLINE ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â refined editorial typography only */
.hero h1.hero-title--kinetic {
  font-family: var(--font-geist-sans), Arial, sans-serif !important;
  font-weight: 750 !important;
  letter-spacing: -0.045em !important;
  font-feature-settings: "ss01" on, "cv11" on;
}

.hero h1.hero-title--kinetic .hero-word {
  font-family: inherit !important;
  font-weight: inherit !important;
}

/* Premium interactive hero lettering Ã¢â‚¬â€ consolidated rules */
.hero-title--kinetic .hero-interactive-word {
  display: inline-block;
  white-space: nowrap;
}

.hero-title--kinetic .hero-letter {
  display: inline-block;
  position: relative;
  color: inherit;
  -webkit-text-fill-color: currentColor;
  transform-origin: 50% 75%;
  transition:
    color 180ms ease,
    -webkit-text-fill-color 180ms ease,
    transform 220ms cubic-bezier(.2, .8, .2, 1),
    text-shadow 180ms ease;
}

.hero .hero-title--kinetic .hero-word--gradient {
  background: none !important;
  color: #d9c0ff !important;
  -webkit-text-fill-color: #d9c0ff !important;
}

.hero .hero-title--kinetic .hero-word--gradient .hero-letter {
  background: none !important;
  color: inherit;
  -webkit-text-fill-color: currentColor;
}

@media (hover: hover) and (pointer: fine) {
  .hero-title--kinetic .hero-letter.is-active {
    z-index: 2;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-title--kinetic .hero-letter {
    transition: none;
    transform: none !important;
    text-shadow: none !important;
  }
}

/* Definitive fix: visible gradient text and independent hover colors */
.hero .hero-title--kinetic .hero-word--gradient {
  background: none !important;
  color: #d9c0ff !important;
  -webkit-text-fill-color: #d9c0ff !important;
}

.hero .hero-title--kinetic .hero-word--gradient .hero-letter {
  background: none !important;
  background-clip: border-box !important;
  -webkit-background-clip: border-box !important;
  color: #d9c0ff !important;
  -webkit-text-fill-color: #d9c0ff !important;
}

.hero .hero-title--kinetic .hero-letter.is-active {
  color: var(--hero-hover-color) !important;
  -webkit-text-fill-color: var(--hero-hover-color) !important;
  text-shadow: 0 0 18px var(--hero-hover-color);
}

/* FINAL: restore vivid per-letter hover colors */
.hero .hero-title--kinetic .hero-letter {
  transition:
    color 180ms ease,
    -webkit-text-fill-color 180ms ease,
    transform 220ms cubic-bezier(.2, .8, .2, 1),
    text-shadow 180ms ease;
}

.hero .hero-title--kinetic .hero-letter.is-active {
  color: var(--hero-hover-color, #FFE44D) !important;
  -webkit-text-fill-color: var(--hero-hover-color, #FFE44D) !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  text-shadow: 0 0 18px var(--hero-hover-color, #FFE44D) !important;
  z-index: 2;
}

/* Keep the original lavender styling when not hovering */
.hero .hero-title--kinetic .hero-word--gradient .hero-letter:not(.is-active) {
  color: #D9C0FF !important;
  -webkit-text-fill-color: #D9C0FF !important;
}

/* Digi Shatakshi logo inside the enquiry popup */
.genie-popup__brand {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.genie-popup__brand-logo {
  display: block;
  width: min(82%, 320px);
  max-height: 260px;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 12px 28px rgb(0 0 0 / 18%));
}

/* Keep the logo comfortably sized on smaller screens */
@media (max-width: 700px) {
  .genie-popup__brand-logo {
    width: min(58%, 220px);
    max-height: 135px;
  }
}

/* Final popup form and Terms & Conditions repair */
.genie-popup-backdrop > .genie-popup > .genie-popup__content {
  box-sizing: border-box !important;
  min-width: 0 !important;
  padding-bottom: 28px !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.5) transparent;
  overscroll-behavior: contain;
}

.genie-popup-backdrop .genie-enquiry-form {
  padding-bottom: 8px !important;
}

.genie-popup-backdrop .genie-enquiry-form > button[type="submit"] {
  margin-bottom: 4px !important;
  white-space: normal;
  line-height: 1.4 !important;
}

.genie-terms-link {
  display: block;
  width: fit-content;
  margin: 2px auto 10px;
  padding: 5px 8px;
  border: 0;
  background: transparent;
  color: #a9f5ef;
  font: inherit;
  font-size: 0.8rem;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}

.genie-terms-link:hover {
  color: #fff;
}

/* Terms modal */
.genie-terms-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2147483647;
  display: grid;
  place-items: center;
  box-sizing: border-box;
  padding: 20px;
  background: rgba(3, 8, 23, 0.78);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.genie-terms-modal {
  position: relative;
  box-sizing: border-box;
  width: min(100%, 460px);
  max-height: min(80dvh, 560px);
  overflow-y: auto;
  padding: 32px;
  border: 1px solid rgba(120, 230, 220, 0.65);
  border-radius: 22px;
  background:
    radial-gradient(ellipse at top right, rgba(70, 210, 200, 0.16), transparent 55%),
    linear-gradient(145deg, #172443, #211b43);
  color: #f8faff;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
}

.genie-terms-eyebrow {
  margin: 0 0 10px;
  color: #78e6dc;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.genie-terms-modal h3 {
  margin: 0 36px 16px 0;
  color: #fff;
  font-size: clamp(1.5rem, 4vw, 2rem);
  line-height: 1.15;
  letter-spacing: -0.04em;
}

.genie-terms-modal > p:not(.genie-terms-eyebrow) {
  margin: 0;
  color: #d8e0f2;
  font-size: 0.95rem;
  line-height: 1.8;
}

.genie-terms-close {
  position: absolute;
  top: 14px;
  right: 14px;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  font-size: 1.5rem;
  cursor: pointer;
}

.genie-terms-done {
  width: 100%;
  min-height: 44px;
  margin-top: 24px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(100deg, #7ce9df, #a9a0ff);
  color: #10162d;
  font: inherit;
  font-weight: 750;
  cursor: pointer;
}

.genie-terms-close:focus-visible,
.genie-terms-done:focus-visible,
.genie-terms-link:focus-visible {
  outline: 2px solid #ffe69a;
  outline-offset: 3px;
}

@media (max-width: 700px) {
  .genie-terms-modal {
    padding: 26px 22px;
    border-radius: 18px;
  }
}

/* =========================================================
   DIGI SHATAKSHI Ã¢â‚¬â€ LIGHT BRAND-COLOUR HERO
   Scoped to the hero; preserves its existing structure.
   ========================================================= */

.hero.section-shell {
  background:
    radial-gradient(
      ellipse at 78% 15%,
      rgb(49 93 235 / 13%),
      transparent 34%
    ),
    radial-gradient(
      ellipse at 12% 90%,
      rgb(40 167 101 / 10%),
      transparent 29%
    ),
    radial-gradient(
      ellipse at 53% 100%,
      rgb(247 200 75 / 16%),
      transparent 35%
    ),
    radial-gradient(
      ellipse at 96% 70%,
      rgb(232 76 61 / 8%),
      transparent 28%
    ),
    linear-gradient(125deg, #f8f9ff 0%, #edf2ff 52%, #fffaf0 100%) !important;
  border: 1px solid rgb(255 255 255 / 90%);
  box-shadow:
    0 24px 80px rgb(37 58 116 / 12%),
    inset 0 1px 0 rgb(255 255 255 / 90%);
}

/* Soft brand-colour atmosphere */
.hero .hero__orb--one {
  background: radial-gradient(
    circle,
    rgb(49 93 235 / 18%) 0%,
    rgb(49 93 235 / 5%) 48%,
    transparent 72%
  ) !important;
  opacity: 1;
}

.hero .hero__orb--two {
  background: radial-gradient(
    circle,
    rgb(247 200 75 / 22%) 0%,
    rgb(40 167 101 / 8%) 48%,
    transparent 72%
  ) !important;
  opacity: 1;
}

.hero .hero__grid {
  opacity: 0.14;
}

/* Replace white headline text with deep brand ink */
.hero .hero-title--kinetic .hero-word--white,
.hero .hero-title--kinetic .hero-word--white .hero-letter:not(.is-active),
.hero .hero-title--kinetic .hero-word--blue {
  color: #18264a !important;
  -webkit-text-fill-color: #18264a !important;
  text-shadow: none !important;
}

/* Keep Digital Marketing visible in the brand's blue-violet range */
.hero .hero-title--kinetic .hero-word--gradient {
  color: #315deB !important;
  -webkit-text-fill-color: #315deb !important;
  background: none !important;
  animation: none !important;
}

.hero .hero-title--kinetic .hero-word--gradient .hero-letter:not(.is-active) {
  color: #315deb !important;
  -webkit-text-fill-color: #315deb !important;
}

/* Retain the colourful individual-letter hover effect */
.hero .hero-title--kinetic .hero-letter.is-active {
  color: var(--hero-hover-color, #f7c84b) !important;
  -webkit-text-fill-color: var(--hero-hover-color, #f7c84b) !important;
  text-shadow: 0 0 18px var(--hero-hover-color, #f7c84b) !important;
}

/* Supporting copy */
.hero .hero__description,
.hero .hero__note,
.hero .hero__note > span:last-child,
.hero .hero__bottom,
.hero .hero__bottom > span,
.hero .hero__bottom a {
  color: #465574 !important;
}

.hero .hero__bottom a {
  border-color: rgb(49 93 235 / 25%) !important;
}

.hero .hero__note-line {
  background: #315deb !important;
}

/* Keep decorative falling stars subtle against the lighter background */
.hero .hero-falling-star {
  opacity: 0.45;
}

/* Carousel captions should remain readable */
.hero .campaign-circular-wrap {
  color: #18264a;
}

/* Mobile polish */
@media (max-width: 760px) {
  .hero.section-shell {
    background:
      radial-gradient(
        ellipse at 80% 8%,
        rgb(49 93 235 / 12%),
        transparent 36%
      ),
      radial-gradient(
        ellipse at 12% 85%,
        rgb(40 167 101 / 9%),
        transparent 30%
      ),
      linear-gradient(145deg, #f8f9ff 0%, #edf2ff 58%, #fffaf0 100%) !important;
  }
}
/* Premium royal-blue + champagne-gold navbar */
.navbar {
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(217, 180, 91, 0.8);
  box-shadow:
    0 0 10px rgba(217, 180, 91, 0.16),
    0 0 24px rgba(217, 180, 91, 0.10),
    0 12px 32px rgba(49, 93, 235, 0.08);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}
/* Fix low-contrast text on the light hero background */
.hero .hero__description {
  color: #40558A !important;
  -webkit-text-fill-color: #40558A !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

.hero .campaign-circular-wrap {
  color: #315DEB !important;
  opacity: 1 !important;
}

.hero .campaign-circular-wrap h2,
.hero .campaign-circular-wrap h3,
.hero .campaign-circular-wrap p,
.hero .campaign-circular-wrap span {
  opacity: 1 !important;
}

.hero .campaign-circular-wrap h2,
.hero .campaign-circular-wrap h3 {
  color: #315DEB !important;
  -webkit-text-fill-color: #315DEB !important;
}

.hero .campaign-circular-wrap p {
  color: #52679A !important;
  -webkit-text-fill-color: #52679A !important;
}

.hero .campaign-circular-wrap span {
  color: #8056D9 !important;
  -webkit-text-fill-color: #8056D9 !important;
}

/* Position images just outside the sphere's glowing rim */
.services-section .crystal-service__side-images {
  position: absolute !important;
  inset: 0 !important;
  z-index: 4 !important;
  overflow: visible !important;
  pointer-events: none !important;
}


.services-section .crystal-service__image--left {
  left: calc(50% - 364px - clamp(120px, 10vw, 160px)) !important;
  right: auto !important;
  transform: translateY(-50%) rotate(-3deg) !important;
}

.services-section .crystal-service__image--right {
  right: calc(50% - 364px - clamp(120px, 10vw, 160px)) !important;
  left: auto !important;
  transform: translateY(-50%) rotate(3deg) !important;
}

.services-section .crystal-service__image img {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important;
}

/* Avoid overlap on smaller screens */
