}

.genie-enquiry-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px 11px;
  margin-top: 12px;
}

.genie-enquiry-form label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
  color: #f8f5ff;
  font-size: 0.72rem;
  font-weight: 600;
}

.genie-enquiry-form input,
.genie-enquiry-form select,
.genie-enquiry-form textarea {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  border: 1px solid rgba(255,255,255,.24);
  border-radius: 9px;
  padding: 9px 10px;
  color: #21152f;
  background: #fff;
  font: inherit;
  font-size: 0.78rem;
  outline-offset: 2px;
}

.genie-enquiry-form textarea {
  min-height: 54px;
  resize: vertical;
}

.genie-enquiry-form .genie-enquiry-full,
.genie-enquiry-form > button,
.genie-enquiry-status {
  grid-column: 1 / -1;
}

.genie-enquiry-form > button {
  min-height: 42px;
  border: 0;
  border-radius: 10px;
  padding: 10px 14px;
  color: #241331;
  background: linear-gradient(100deg, #ffe69a, #ffc86a);
  font: inherit;
  font-size: .82rem;
  font-weight: 750;
  cursor: pointer;
}

.genie-enquiry-form > button:disabled {
  cursor: wait;
  opacity: .7;
}

.genie-enquiry-status {
  margin: 0 !important;
  overflow-wrap: anywhere;
  font-size: .78rem !important;
}

@media (max-width: 700px) {
  .genie-popup-backdrop > .genie-popup > .genie-popup__content {
    width: 100% !important;
    max-width: none !important;
    margin: 155px 0 0 !important;
    max-height: calc(100% - 155px);
    overflow-y: auto;
  }

  .genie-enquiry-form {
    gap: 8px;
  }

  .genie-enquiry-form input,
  .genie-enquiry-form select,
  .genie-enquiry-form textarea {
    padding: 8px;
  }
}

@media (max-height: 700px) and (min-width: 701px) {
  .genie-popup-backdrop > .genie-popup > .genie-popup__content {
    max-height: calc(100% - 4px);
    overflow-y: auto;
  }
}

