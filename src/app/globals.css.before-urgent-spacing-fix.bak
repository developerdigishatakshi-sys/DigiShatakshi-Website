}

.services-section .crystal-service {
  position: relative;
  inset: auto;
  z-index: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-self: stretch;
  width: 100%;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: clamp(18px, 2vw, 28px);
  overflow: visible;
  border-radius: 28px;
  color: #24264a;
  text-decoration: none;
  isolation: isolate;
