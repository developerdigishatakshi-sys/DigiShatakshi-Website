/* DIGI STAKSHI ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â champagne gold navbar theme */
.site-header {
  background: rgba(10, 16, 32, 0.96) !important;
  border: 1px solid rgba(214, 184, 117, 0.48) !important;
  color: #f4f0e7 !important;
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.22) !important;
  backdrop-filter: blur(20px) saturate(135%);
  -webkit-backdrop-filter: blur(20px) saturate(135%);
}

.site-header .site-nav__link {
  color: #eee9df !important;
}

.site-header .site-nav__link:hover,
.site-header .site-nav__link:focus-visible {
  color: #e4c783 !important;
}

.site-header .site-nav__link::after {
  background: #d6b875 !important;
}

.site-header .site-nav__link:focus-visible {
  outline-color: #d6b875 !important;
}

.site-header .button--nav {
