/* Hindi SEO word-by-word typing */
.services-section .seo-word-typing {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: baseline;
  gap: 0.12em 0.34em;
  max-width: 340px;
  margin: 16px auto;
  font-family: "Noto Sans Devanagari", "Nirmala UI", sans-serif;
  font-size: clamp(17px, 1.45vw, 22px);
  font-weight: 750;
  line-height: 1.85;
  letter-spacing: 0;
  text-align: center;
  text-wrap: pretty;
}

.services-section .seo-word-typing--left {
  color: #f3d58a;
  text-shadow: 0 2px 18px rgb(243 213 138 / 18%);
}

.services-section .seo-word-typing--right {
  color: #e2d9ff;
  text-shadow: 0 2px 18px rgb(167 139 250 / 24%);
}

.services-section .seo-word-typing__word {
  display: inline-block;
  animation: seo-word-appear 240ms ease both;
}

.services-section .seo-word-typing__cursor {
  width: 2px;
  height: 1.1em;
  margin-left: 2px;
  background: #d8b56a;
  animation: seo-cursor-blink 850ms step-end infinite;
}

@keyframes seo-word-appear {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes seo-cursor-blink {
  50% { opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .services-section .seo-word-typing__word,
  .services-section .seo-word-typing__cursor {
    animation: none;
  }
}

/* POSITION HINDI TYPING MESSAGES AROUND SPHERE */
.services-section .crystal-service > .seo-word-typing {
  position: absolute;
  top: 50%;
  z-index: 5;
  display: flex;
  width: min(22vw, 300px);
  max-width: 300px;
  margin: 0;
  padding: 12px;
  transform: translateY(-50%);
  pointer-events: none;
}

.services-section .crystal-service > .seo-word-typing--left {
  left: max(18px, calc(50% - 570px));
}

.services-section .crystal-service > .seo-word-typing--right {
  right: max(18px, calc(50% - 570px));
}

@media (max-width: 900px) {
  .services-section .crystal-service > .seo-word-typing {
    width: 24%;
    padding: 4px;
    font-size: clamp(13px, 1.8vw, 17px);
    line-height: 1.6;
  }

  .services-section .crystal-service > .seo-word-typing--left {
    left: 1%;
  }

  .services-section .crystal-service > .seo-word-typing--right {
    right: 1%;
  }
}

@media (max-width: 620px) {
  .services-section .crystal-service > .seo-word-typing {
    top: auto;
    bottom: 12px;
    width: 44%;
    font-size: 13px;
    line-height: 1.5;
    transform: none;
  }
}
/* FIX HINDI CAPTION OVERLAP */
.services-section .crystal-service > .seo-word-typing {
  top: 27% !important;
  bottom: auto !important;
  z-index: 8 !important;
  width: min(25vw, 280px) !important;
  max-width: 280px !important;
  padding: 8px 12px !important;
  margin: 0 !important;
  transform: translateY(-50%) !important;
  font-size: clamp(15px, 1.25vw, 19px) !important;
  line-height: 1.65 !important;
  text-shadow: 0 2px 10px rgba(20, 12, 48, 0.28) !important;
}

.services-section .crystal-service > .seo-word-typing--left {
  left: 27% !important;
  right: auto !important;
}

.services-section .crystal-service > .seo-word-typing--right {
  left: auto !important;
  right: 27% !important;
}

@media (max-width: 760px) {
  .services-section .crystal-service > .seo-word-typing {
    top: 16% !important;
    width: 42% !important;
    font-size: 13px !important;
    line-height: 1.5 !important;
  }

  .services-section .crystal-service > .seo-word-typing--left {
    left: 2% !important;
  }

  .services-section .crystal-service > .seo-word-typing--right {
