/* OUR SERVICES ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â rotating circular text */
.services-orbit {
  position: relative;
  display: grid;
  width: 132px;
  height: 132px;
  place-items: center;
  margin: 0;
  color: #4263eb;
}

.services-orbit__ring {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
  animation: services-orbit-spin 18s linear infinite;
}

.services-orbit__ring text {
  fill: currentColor;
  font-family: var(--font-geist-sans), Arial, sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.services-orbit__center {
  position: absolute;
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid rgb(66 99 235 / 25%);
  border-radius: 50%;
  background: #fffefa;
  color: #192541;
  font-size: 23px;
  transition: transform 220ms ease;
}

.services-orbit:hover .services-orbit__center {
  transform: scale(1.08);
}

@keyframes services-orbit-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
