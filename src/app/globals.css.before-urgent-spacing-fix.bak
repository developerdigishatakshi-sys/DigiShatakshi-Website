/* DIGI STAKSHI ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â consolidated hero refinement */
.hero .campaign-carousel__stage {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 0.94 / 1;
  max-height: 430px;
  border-radius: 24px;
  background: #f7f9ff;
  box-shadow: 0 16px 40px rgb(5 14 35 / 14%);
}

.hero .campaign-carousel__stage .hero-visual__image {
  position: absolute !important;
  inset: 0;
  z-index: 1;
  width: 100% !important;
  height: 100% !important;
  border-radius: inherit;
  object-fit: contain;
  object-position: center;
}

.hero .hero-visual--carousel {
  min-width: 0;
  overflow: visible;
}

.hero .campaign-side-image {
  display: none !important;
}

.hero .hero-problem-card {
  display: none !important;
}

.hero .hero-visual__counter,
.hero .hero-visual__slide-label {
  display: none !important;
}

.hero .hero__orb--one,
.hero .hero__orb--two {
  opacity: 0.12;
}

.hero .hero-falling-stars--page {
  opacity: 0.35;
}

@media (max-width: 760px) {
