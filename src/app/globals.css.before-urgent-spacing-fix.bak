  border: 1px solid #C6E0CC !important;
}

.why-section .why-grid > .why-card:nth-child(3n + 3) {
  background: #FBE8DC !important;
  border: 1px solid #F0D0BC !important;
}

.why-section .why-grid > .why-card {
  color: #252A36 !important;
  transition: transform 240ms ease, box-shadow 240ms ease;
}

.why-section .why-grid > .why-card h3 {
  color: #252A36 !important;
}

.why-section .why-grid > .why-card p {
