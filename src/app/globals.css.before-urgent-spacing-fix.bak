}

.site-header .button--nav:hover {
  background: linear-gradient(135deg, #f1dca7, #d6b875) !important;
  color: #101626 !important;
  box-shadow: 0 9px 24px rgba(201, 164, 93, 0.28) !important;
}

.site-header .menu-toggle {
  border-color: rgba(214, 184, 117, 0.45) !important;
  background: rgba(214, 184, 117, 0.08) !important;
}

.site-header .menu-toggle span {
  background: #e4c783 !important;
}

@media (max-width: 760px) {
  .site-header .site-nav {
    background: #0d1528 !important;
