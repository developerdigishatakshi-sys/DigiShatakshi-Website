/* Animated, fully clothed cartoon genie */
.genie-popup__genie {
  position: absolute;
  z-index: 2;
  left: -1%;
  bottom: -7%;
  width: 47%;
  max-width: 245px;
  pointer-events: none;
  transform-origin: 50% 75%;
  animation: popup-genie-float 4s ease-in-out infinite;
  filter: drop-shadow(0 0 20px rgb(73 191 255 / 35%));
}

.genie-popup__genie svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}

.genie-popup__genie::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 12% -15% 0;
  border-radius: 50%;
  background: radial-gradient(
    ellipse,
    rgb(76 100 255 / 26%),
    rgb(194 58 255 / 12%) 48%,
    transparent 72%
  );
  filter: blur(18px);
  animation: popup-genie-aura 3.5s ease-in-out infinite alternate;
}

@keyframes popup-genie-float {
  0%, 100% { transform: translateY(0) rotate(-1deg); }
  50% { transform: translateY(-10px) rotate(1deg); }
}

@keyframes popup-genie-aura {
  from { opacity: .55; transform: scale(.92); }
  to { opacity: 1; transform: scale(1.08); }
}

@media (max-width: 520px) {
  .genie-popup__genie {
    left: -5%;
    bottom: -3%;
    width: 39%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .genie-popup__genie,
  .genie-popup__genie::before {
    animation: none !important;
  }
}

