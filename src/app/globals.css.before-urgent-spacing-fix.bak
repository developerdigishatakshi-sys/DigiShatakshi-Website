@import "tailwindcss";

:root {
  color-scheme: light;
  --background: #f7f6f2;
  --surface: #fffefa;
  --surface-soft: #efeee8;
  --foreground: #20251f;
  --muted: #6c716a;
  --line: #dfdfd5;
  --accent: #c4f169;
  --accent-strong: #a5d83f;
  --blue: #dce9fa;
  --ink: #20251f;
  --radius-card: 1.25rem;
  --container: 1180px;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-geist-sans), Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

body,
button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  touch-action: manipulation;
}

button {
  font: inherit;
}

::selection {
  background: var(--accent);
  color: var(--ink);
}

:focus-visible {
  outline: 3px solid #597c18;
  outline-offset: 4px;
}

.skip-link {
  position: fixed;
  z-index: 100;
  top: 12px;
  left: 12px;
  padding: 12px 16px;
  border-radius: 10px;
  background: var(--ink);
  color: white;
  transform: translateY(-160%);
}

.skip-link:focus {
  transform: translateY(0);
}

.container {
  width: min(calc(100% - 48px), var(--container));
  margin-inline: auto;
}

.section-shell {
  position: relative;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin: 0;
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 650;
  letter-spacing: 0.13em;
  line-height: 1.5;
  text-transform: uppercase;
}

.text-accent {
  color: #697f35;
}

.site-header {
  position: sticky;
  z-index: 50;
  top: 0;
  border-bottom: 1px solid rgb(32 37 31 / 7%);
  background: rgb(247 246 242 / 88%);
  backdrop-filter: blur(18px);
}

.site-header__inner {
  display: flex;
  width: min(calc(100% - 48px), 1320px);
  min-height: 82px;
  align-items: center;
  justify-content: space-between;
  margin-inline: auto;
}

.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 11px;
}

.brand-mark {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 13px;
  background: var(--ink);
  color: white;
  font-size: 1.1rem;
  font-weight: 750;
  letter-spacing: -0.08em;
}

.brand-mark__dot {
  color: var(--accent);
}

.brand-lockup__copy {
  display: grid;
  gap: 2px;
}

.brand-lockup__name {
  font-size: 0.9rem;
  font-weight: 750;
  letter-spacing: -0.03em;
}

.brand-lockup__descriptor {
  color: var(--muted);
  font-size: 0.64rem;
  letter-spacing: 0.015em;
}

.site-nav {
  display: flex;
  align-items: center;
  gap: clamp(18px, 2.4vw, 34px);
}

.site-nav__link {
  color: #50564e;
  font-size: 0.86rem;
  font-weight: 520;
  transition: color 180ms ease;
}

.site-nav__link:hover {
  color: #6c882d;
}

.button {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 16px;
  padding: 0 20px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 0.87rem;
  font-weight: 650;
  transition:
    background 180ms ease,
    color 180ms ease,
    border-color 180ms ease,
    transform 180ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button--nav {
  min-height: 43px;
  gap: 12px;
  background: var(--ink);
  color: white;
}

.button--nav:hover,
.button--primary:hover {
  background: #3a4332;
}

.menu-toggle {
  display: none;
}

.hero {
  min-height: min(750px, calc(100svh - 82px));
  overflow: hidden;
  background: var(--background);
}

.hero__ambient {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgb(32 37 31 / 3%) 1px, transparent 1px),
    linear-gradient(90deg, rgb(32 37 31 / 3%) 1px, transparent 1px);
  background-size: 58px 58px;
  mask-image: linear-gradient(to bottom, black, transparent 85%);
}

.hero__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(1px);
}

.hero__orb--one {
  top: 8%;
  right: 6%;
  width: 390px;
  height: 390px;
  background: radial-gradient(circle at 40% 35%, #e4f5b9 0, #d9eab5 30%, rgb(217 234 181 / 0%) 72%);
}

.hero__orb--two {
  right: 26%;
  bottom: 0;
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgb(207 225 248 / 68%), rgb(207 225 248 / 0%) 72%);
}

.hero__content {
  position: relative;
  display: grid;
  min-height: 625px;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 30px;
  padding-block: 76px 58px;
}

.hero__copy {
  position: relative;
  z-index: 2;
  max-width: 660px;
}

.hero__eyebrow {
  padding: 9px 13px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgb(255 254 250 / 65%);
  letter-spacing: 0.06em;
  text-transform: none;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #83b92e;
  box-shadow: 0 0 0 4px rgb(131 185 46 / 14%);
}

.hero h1 {
  margin: 28px 0 0;
  font-size: clamp(3.5rem, 6.4vw, 6.15rem);
  font-weight: 560;
  letter-spacing: -0.085em;
  line-height: 0.99;
}

.hero__headline-accent {
  color: #738c40;
}

.hero__description {
  max-width: 500px;
  margin: 25px 0 0;
  color: var(--muted);
  font-size: clamp(1rem, 1.3vw, 1.12rem);
  line-height: 1.85;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 24px;
  margin-top: 32px;
}

.button--primary {
  background: var(--ink);
  color: white;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 0.87rem;
  font-weight: 650;
}

.text-link span,
.footer-cta span {
  transition: transform 180ms ease;
}

.text-link:hover span,
.footer-cta:hover span {
  transform: translate(3px, -3px);
}

.hero__note {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 48px;
  color: var(--muted);
  font-size: 0.76rem;
}

.hero__note-line {
  width: 28px;
  height: 1px;
  background: #8b9f62;
}

.hero-art {
  position: relative;
  width: min(100%, 480px);
  aspect-ratio: 1;
  justify-self: end;
  isolation: isolate;
}

.hero-art__orbit {
  position: absolute;
  top: 50%;
  left: 50%;
  border: 1px solid rgb(88 105 66 / 19%);
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-24deg);
}

.hero-art__orbit--outer {
  width: 94%;
  height: 61%;
}

.hero-art__orbit--inner {
  width: 72%;
  height: 88%;
  transform: translate(-50%, -50%) rotate(32deg);
}

.hero-art__center {
  position: absolute;
  top: 50%;
  left: 50%;
  display: grid;
  width: 164px;
  height: 164px;
  align-content: center;
  justify-items: center;
  border: 1px solid rgb(255 255 255 / 75%);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 25%, #eff9d6, #c9e69a 75%);
  box-shadow: 0 25px 70px rgb(95 122 49 / 17%), inset 0 0 25px rgb(255 255 255 / 60%);
  transform: translate(-50%, -50%);
}

.hero-art__monogram {
  font-size: 3.7rem;
  font-weight: 780;
  letter-spacing: -0.12em;
}

.hero-art__center-label {
  margin-top: 2px;
  color: #4e6131;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.hero-art__card {
  position: absolute;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 15px;
  border: 1px solid rgb(32 37 31 / 8%);
  border-radius: 14px;
  background: rgb(255 254 250 / 90%);
  box-shadow: 0 12px 35px rgb(32 37 31 / 7%);
  font-size: 0.76rem;
  font-weight: 650;
  animation: float 6s ease-in-out infinite;
}

.hero-art__card--top {
  top: 12%;
  left: 15%;
}

.hero-art__card--right {
  top: 48%;
  right: -2%;
  animation-delay: -2s;
}

.hero-art__card--bottom {
  bottom: 13%;
  left: 9%;
  animation-delay: -4s;
}

.hero-art__card-icon {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 9px;
  background: #edf4df;
  color: #58742b;
  font-size: 1rem;
}

.hero-art__spark {
  position: absolute;
  z-index: 1;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #9cc94d;
  box-shadow: 0 0 0 7px rgb(156 201 77 / 13%);
}

.hero-art__spark--one {
  top: 25%;
  right: 20%;
}

.hero-art__spark--two {
  bottom: 26%;
  right: 22%;
  width: 6px;
  height: 6px;
  background: #93b8e5;
  box-shadow: 0 0 0 6px rgb(147 184 229 / 18%);
}

.hero__bottom {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-block: 18px 23px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.73rem;
}

.hero__bottom a {
  display: grid;
  width: 33px;
  height: 33px;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  font-size: 1.1rem;
}

.intro-section {
  padding-block: 120px;
  background: var(--surface);
}

.intro-section__grid {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 50px;
}

.section-heading {
  margin: 0;
  font-size: clamp(2.6rem, 4.7vw, 4.5rem);
  font-weight: 540;
  letter-spacing: -0.075em;
  line-height: 1.08;
}

.section-copy {
  max-width: 650px;
  margin: 24px 0 0;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.9;
}

.services-section {
  padding-block: 110px 120px;
}

.section-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 42px;
}

.section-header .eyebrow,
.approach-section__intro .eyebrow {
  margin-bottom: 20px;
}

.section-header > .text-link {
  margin-bottom: 8px;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.service-card {
  position: relative;
  display: flex;
  min-height: 260px;
  flex-direction: column;
  justify-content: space-between;
  padding: 25px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--surface);
  transition:
    transform 220ms ease,
    border-color 220ms ease,
    box-shadow 220ms ease;
}

.service-card:hover {
  transform: translateY(-5px);
  border-color: #b5c792;
  box-shadow: 0 20px 50px rgb(32 37 31 / 6%);
}

.service-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-card__number {
  color: #81877a;
  font-family: var(--font-geist-mono), monospace;
  font-size: 0.75rem;
}

.service-card__tag {
  padding: 6px 9px;
  border: 1px solid #e3e5db;
  border-radius: 999px;
  color: #5d6554;
  font-size: 0.66rem;
}

.service-card__body {
  padding-right: 15px;
}

.service-card h3 {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 620;
  letter-spacing: -0.045em;
  line-height: 1.3;
}

.service-card p {
  margin: 12px 0 0;
  color: var(--muted);
  font-size: 0.86rem;
  line-height: 1.75;
}

.service-card__arrow {
  position: absolute;
  right: 22px;
  bottom: 21px;
  color: #6c882d;
  font-size: 1.1rem;
  transition: transform 180ms ease;
}

.service-card:hover .service-card__arrow {
  transform: translate(3px, -3px);
}

.approach-section {
  padding-block: 110px 125px;
  background: #efeee8;
}

.approach-section__intro {
  max-width: 730px;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
  margin-top: 58px;
}

.process-card__number {
  color: #748b48;
  font-family: var(--font-geist-mono), monospace;
  font-size: 0.78rem;
}

.process-card__rule {
  height: 1px;
  margin-block: 22px;
  background: #d0d2c6;
}

.process-card h3 {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 630;
  letter-spacing: -0.04em;
}

.process-card p {
  max-width: 240px;
  margin: 12px 0 0;
  color: var(--muted);
  font-size: 0.87rem;
  line-height: 1.8;
}

.closing-section {
  padding-block: 100px;
  background: var(--surface);
}

.closing-card {
  position: relative;
  padding: clamp(38px, 7vw, 86px);
  overflow: hidden;
  border-radius: 28px;
  background: #252c22;
  color: #fffefa;
}

.closing-card__orb {
  position: absolute;
  top: -210px;
  right: -60px;
  width: 470px;
  height: 470px;
  border-radius: 50%;
  background: radial-gradient(circle, rgb(196 241 105 / 28%), rgb(196 241 105 / 0%) 70%);
  pointer-events: none;
}

.closing-card .eyebrow {
  position: relative;
  color: #c6d1b6;
}

.closing-card h2 {
  position: relative;
  margin: 25px 0 0;
  font-size: clamp(2.8rem, 5.4vw, 5.2rem);
  font-weight: 530;
  letter-spacing: -0.08em;
  line-height: 1.04;
}

.closing-card h2 span {
  color: var(--accent);
}

.closing-card__copy {
  position: relative;
  max-width: 520px;
  margin: 23px 0 30px;
  color: #c2c8bd;
  font-size: 0.97rem;
  line-height: 1.85;
}

.button--light {
  position: relative;
  background: var(--accent);
  color: var(--ink);
}

.button--light:hover {
  background: #d5f69a;
}

.site-footer {
  padding-top: 70px;
  background: var(--background);
}

.site-footer__main {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr 1fr;
  gap: 55px;
  padding-bottom: 58px;
}

.site-footer__brand > p {
  max-width: 330px;
  margin: 20px 0 0;
  color: var(--muted);
  font-size: 0.86rem;
  line-height: 1.85;
}

.site-footer__links,
.site-footer__contact {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: 15px;
}

.site-footer__links > a {
  color: #555b51;
  font-size: 0.85rem;
}

.site-footer__links > a:hover {
  color: #6c882d;
}

.site-footer__contact .eyebrow {
  margin-bottom: 4px;
}

.footer-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 1.2rem;
  font-weight: 620;
  letter-spacing: -0.035em;
}

.site-footer__bottom {
  display: flex;
  min-height: 65px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.73rem;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@media (min-width: 1440px) {
  .hero__content {
    min-height: 680px;
  }
}

@media (max-width: 900px) {
  .hero__content {
    grid-template-columns: 1fr 0.8fr;
    gap: 10px;
  }

  .hero h1 {
    font-size: clamp(3.3rem, 7.3vw, 5rem);
  }

  .hero-art__card {
    gap: 7px;
    padding: 10px;
    font-size: 0.67rem;
  }

  .hero-art__center {
    width: 130px;
    height: 130px;
  }

  .hero-art__monogram {
    font-size: 3rem;
  }

  .services-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__main {
    gap: 28px;
  }
}

@media (max-width: 680px) {
  .container,
  .site-header__inner {
    width: min(calc(100% - 36px), var(--container));
  }

  .site-header__inner {
    min-height: 72px;
  }

  .brand-mark {
    width: 38px;
    height: 38px;
  }

  .menu-toggle {
    display: flex;
    width: 43px;
    height: 43px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    cursor: pointer;
  }

  .menu-toggle span {
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink);
  }

  .site-nav {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    left: 0;
    display: none;
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    padding: 12px 18px 20px;
    border-bottom: 1px solid var(--line);
    background: var(--background);
    box-shadow: 0 18px 28px rgb(32 37 31 / 5%);
  }

  .site-nav--open {
    display: flex;
  }

  .site-nav__link {
    padding: 14px 3px;
    border-bottom: 1px solid var(--line);
  }

  .button--nav {
    margin-top: 15px;
  }

  .hero {
    min-height: unset;
  }

  .hero__content {
    min-height: unset;
    grid-template-columns: 1fr;
    gap: 5px;
    padding-block: 62px 28px;
  }

  .hero h1 {
    margin-top: 24px;
    font-size: clamp(3.4rem, 13.5vw, 5rem);
  }

  .hero__description {
    margin-top: 20px;
    font-size: 0.98rem;
  }

  .hero__actions {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
    margin-top: 26px;
  }

  .hero__note {
    align-items: flex-start;
    margin-top: 29px;
    font-size: 0.7rem;
  }

  .hero-art {
    width: min(100%, 370px);
    margin: 18px auto 0;
  }

  .hero-art__card--right {
    right: -1%;
  }

  .hero__bottom {
    font-size: 0.67rem;
  }

  .intro-section,
  .services-section,
  .approach-section {
    padding-block: 76px;
  }

  .intro-section__grid {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .section-heading {
    font-size: clamp(2.7rem, 10vw, 3.7rem);
  }

  .section-header {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 30px;
  }

  .services-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .service-card {
    min-height: 230px;
  }

  .process-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 18px;
    margin-top: 38px;
  }

  .process-card__rule {
    margin-block: 15px;
  }

  .process-card h3 {
    font-size: 1.1rem;
  }

  .process-card p {
    font-size: 0.82rem;
  }

  .closing-section {
    padding-block: 65px;
  }

  .closing-card {
    padding: 38px 25px;
    border-radius: 22px;
  }

  .closing-card h2 {
    font-size: clamp(2.7rem, 10.5vw, 4rem);
  }

  .site-footer {
    padding-top: 55px;
  }

  .site-footer__main {
    grid-template-columns: 1fr 1fr;
    gap: 38px 20px;
    padding-bottom: 42px;
  }

  .site-footer__brand {
    grid-column: 1 / -1;
  }

  .site-footer__contact {
    grid-column: 1 / -1;
  }

  .site-footer__bottom {
    min-height: 60px;
    font-size: 0.67rem;
  }
}

@media (max-width: 380px) {
  .brand-lockup__descriptor {
    font-size: 0.58rem;
  }

  .process-grid {
    grid-template-columns: 1fr;
  }

  .hero__bottom {
    gap: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* === Hero motion: kinetic type + interactive constellation === */

.hero-title {
  perspective: 900px;
}

.hero-title__line {
  display: block;
  overflow: hidden;
  padding-bottom: 0.07em;
  margin-bottom: -0.07em;
}

.hero-title__word {
  display: inline-block;
  transform-origin: 50% 100%;
  animation: hero-word-arrive 900ms cubic-bezier(0.16, 1, 0.3, 1) both; animation-iteration-count: infinite; animation-delay: 2s;
}

@keyframes hero-word-arrive {
  0% {
    opacity: 0;
    transform: translate3d(0, 105%, 0) rotateX(-12deg);
    filter: blur(7px);
  }
  65% {
    opacity: 1;
    filter: blur(0);
  }
  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotateX(0);
    filter: blur(0);
  }
}

.hero-visual {
  position: relative;
  width: min(100%, 510px);
  aspect-ratio: 1;
  justify-self: end;
  isolation: isolate;
}

.hero-visual__canvas {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.hero-visual__label {
  position: absolute;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 10px 13px;
  border: 1px solid rgb(32 37 31 / 9%);
  border-radius: 999px;
  background: rgb(255 254 250 / 83%);
  box-shadow: 0 8px 28px rgb(32 37 31 / 5%);
  color: #3d4536;
  font-size: 0.69rem;
  font-weight: 650;
  letter-spacing: 0.01em;
  backdrop-filter: blur(12px);
}

.hero-visual__label--top {
  top: 12%;
  left: 13%;
}

.hero-visual__label--left {
  bottom: 24%;
  left: 3%;
}

.hero-visual__label--right {
  right: 0;
  bottom: 36%;
}

.hero-visual__label > span:not(.hero-visual__label-dot) {
  color: #7b8f5b;
  font-family: var(--font-geist-mono), monospace;
  font-size: 0.65rem;
}

.hero-visual__label-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #94bd48;
  box-shadow: 0 0 0 4px rgb(148 189 72 / 15%);
}

.hero-visual__signature {
  position: absolute;
  right: 8%;
  bottom: 11%;
  display: flex;
  align-items: center;
  gap: 11px;
  color: #73796d;
  font-size: 0.65rem;
  letter-spacing: 0.025em;
}

.hero-visual__signature > span:first-child {
  color: #46523a;
  font-size: 1.1rem;
  font-weight: 800;
  letter-spacing: -0.08em;
}

@media (max-width: 900px) {
  .hero-visual {
    width: min(100%, 440px);
  }
}

@media (max-width: 680px) {
  .hero-visual {
    width: min(100%, 370px);
    justify-self: center;
    margin-top: 12px;
  }

  .hero-visual__label {
    padding: 8px 10px;
    font-size: 0.63rem;
  }

  .hero-visual__label--top {
    left: 7%;
  }

  .hero-visual__label--left {
    left: 0;
  }

  .hero-visual__label--right {
    right: 0;
  }

  .hero-visual__signature {
    right: 5%;
    bottom: 7%;
    font-size: 0.58rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-title__word {
    animation: none;
    opacity: 1;
    filter: none;
    transform: none;
  }
}


/* DF HOMEPAGE POLISH PATCH */

/* ===== DF homepage polish layer =====
   Append to the end of src/app/globals.css.
   Keeps the existing brand palette and animation system. */

:root {
  --background: #f7f6f2;
  --surface: #fffefa;
  --surface-soft: #eeeee6;
  --foreground: #20251f;
  --muted: #626a60;
  --line: #dedfd4;
  --accent: #c4f169;
  --accent-strong: #a5d83f;
  --blue: #dce9fa;
  --ink: #20251f;
  --radius-card: 1.35rem;
  --container: 1220px;
}

body { font-size: 16px; }
.container { width: min(calc(100% - 56px), var(--container)); }
.eyebrow { font-size: .7rem; letter-spacing: .15em; }
.text-accent { color: #637d31; }
.site-header { background: rgb(247 246 242 / 92%); border-bottom-color: rgb(32 37 31 / 9%); }
.site-header__inner { width: min(calc(100% - 56px), 1340px); min-height: 86px; }
.site-nav { gap: clamp(18px, 2vw, 30px); }
.site-nav__link { font-size: .88rem; color: #454d42; }
.button { min-height: 50px; padding-inline: 22px; font-size: .88rem; }
.hero { min-height: 700px; }
.hero__content { min-height: 620px; grid-template-columns: minmax(0, 1.08fr) minmax(340px, .92fr); gap: clamp(24px, 4vw, 62px); padding-block: 72px 48px; }
.hero__copy { max-width: 690px; }
.hero h1 { max-width: 760px; font-size: clamp(3.15rem, 5.3vw, 5.55rem); line-height: 1.02; letter-spacing: -.075em; }
.hero-title__line { overflow: visible; }
.hero__description { max-width: 590px; font-size: clamp(1rem, 1.15vw, 1.1rem); line-height: 1.78; color: #5f675d; }
.hero__actions { gap: 22px; margin-top: 30px; }
.hero__note { margin-top: 34px; }
.hero-visual { width: min(100%, 520px); }
.intro-section, .services-section, .approach-section, .why-section, .clients-section, .testimonials-section, .blogs-section, .faq-section, .inquiry-section { padding-block: clamp(56px, 6vw, 88px); }
.intro-section { background: #fffefa; }
.intro-section__grid { grid-template-columns: .55fr 1.45fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
.section-heading { font-size: clamp(2.4rem, 4.1vw, 4.15rem); line-height: 1.08; letter-spacing: -.067em; font-weight: 560; text-wrap: balance; }
.section-copy { max-width: 680px; font-size: 1rem; line-height: 1.85; color: #626a60; }
.section-intro { max-width: 760px; margin-bottom: 42px; }
.section-intro .eyebrow, .section-header .eyebrow, .approach-section__intro .eyebrow { margin-bottom: 17px; }
.section-intro--compact { max-width: 800px; }
.section-header { margin-bottom: 38px; align-items: end; }
.services-section { background: #f7f6f2; }
.services-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.service-card { min-height: 300px; padding: 24px 22px 23px; border-radius: 20px; background: #fffefa; box-shadow: 0 2px 0 rgb(32 37 31 / 2%); }
.service-card:nth-child(5) { grid-column: 1 / 2; }
.service-card__tag { background: #f4f5ed; color: #59654b; }
.service-card h3 { font-size: clamp(1.08rem, 1.35vw, 1.28rem); line-height: 1.28; letter-spacing: -.04em; }
.service-card p { font-size: .84rem; line-height: 1.72; color: #626a60; }
.service-card__body { padding-right: 0; margin-bottom: 18px; }
.service-card__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; color: #536d27; font-size: .78rem; font-weight: 700; }
.service-card__cta span { transition: transform 180ms ease; }
.service-card:hover .service-card__cta span { transform: translate(3px, -3px); }
.approach-section { background: #eeeee6; }
.approach-section__intro { max-width: 790px; }
.approach-section__intro .section-copy { margin-top: 18px; }
.process-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px 28px; margin-top: 52px; }
.process-card { padding: 24px; border: 1px solid rgb(32 37 31 / 9%); border-radius: 18px; background: rgb(255 254 250 / 72%); transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease; }
.process-card:hover { transform: translateY(-4px); border-color: #c3cdb0; box-shadow: 0 16px 36px rgb(32 37 31 / 5%); }
.process-card__rule { margin-block: 18px; background: #d6d9cc; }
.process-card h3 { font-size: 1.24rem; }
.process-card p { max-width: none; font-size: .88rem; line-height: 1.75; }
.why-section { background: #fffefa; }
.why-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.why-card { min-height: 220px; padding: 27px; border: 1px solid var(--line); border-radius: 20px; background: #fbfaf6; transition: transform 200ms ease, box-shadow 200ms ease; }
.why-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgb(32 37 31 / 6%); }
.why-card__number { color: #718b3b; font-family: var(--font-geist-mono), monospace; font-size: .72rem; }
.why-card h3 { margin: 24px 0 10px; font-size: 1.2rem; line-height: 1.3; letter-spacing: -.035em; }
.why-card p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.75; }
.stats-section { padding-block: 52px 38px; background: #252c22; color: #fffefa; }
.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
.stat-item { display: flex; flex-direction: column; gap: 9px; padding: 8px 0; border-right: 1px solid rgb(255 255 255 / 14%); }
.stat-item:last-child { border-right: 0; }
.stat-item strong { color: var(--accent); font-size: clamp(2.2rem, 4vw, 3.5rem); font-weight: 560; line-height: 1; letter-spacing: -.065em; }
.stat-item span { color: #e0e5d9; font-size: .88rem; }
.stats-note { margin-top: 20px; color: #c4cbbd; font-size: .72rem; }
.clients-section { background: #f7f6f2; }
.client-logo-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
.client-logo-row span { display: grid; min-height: 86px; place-items: center; border: 1px dashed #c9ccbf; border-radius: 15px; color: #7a8174; background: rgb(255 254 250 / 60%); font-size: .8rem; }
.testimonials-section { background: #eeeee6; }
.testimonial-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.testimonial-card { padding: 27px; border: 1px solid rgb(32 37 31 / 8%); border-radius: 20px; background: #fffefa; }
.testimonial-card__quote { color: #779441; font-family: Georgia, serif; font-size: 4rem; line-height: .8; }
.testimonial-card > p { min-height: 86px; margin: 18px 0 28px; color: #525a4f; font-size: .95rem; line-height: 1.8; }
.testimonial-card__person { display: flex; align-items: center; gap: 12px; padding-top: 17px; border-top: 1px solid var(--line); }
.testimonial-avatar { display: grid; width: 39px; height: 39px; place-items: center; border-radius: 50%; background: #e8eedc; color: #526b2c; font-family: var(--font-geist-mono), monospace; font-size: .72rem; }
.testimonial-card__person strong, .testimonial-card__person small { display: block; }
.testimonial-card__person strong { font-size: .85rem; }
.testimonial-card__person small { margin-top: 4px; color: var(--muted); font-size: .75rem; }
.section-footnote { margin: 18px 0 0; color: #72786e; font-size: .75rem; line-height: 1.6; }
.blogs-section { background: #fffefa; }
.blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.blog-card { overflow: hidden; border: 1px solid var(--line); border-radius: 20px; background: #fffefa; transition: transform 200ms ease, box-shadow 200ms ease; }
.blog-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgb(32 37 31 / 7%); }
.blog-card__visual { position: relative; display: flex; min-height: 190px; align-items: flex-start; justify-content: space-between; padding: 18px; overflow: hidden; background: radial-gradient(circle at 72% 35%, #dbeab8, transparent 42%), linear-gradient(135deg, #e9eddf, #f8f6ef); color: #4e5e3b; font-family: var(--font-geist-mono), monospace; font-size: .66rem; letter-spacing: .08em; }
.blog-card__visual::after { position: absolute; right: -24px; bottom: -68px; width: 220px; height: 220px; border: 1px solid rgb(76 98 48 / 22%); border-radius: 50%; content: ""; box-shadow: 0 0 0 20px rgb(255 255 255 / 12%), 0 0 0 42px rgb(76 98 48 / 7%); }
.blog-card__visual--2 { background: radial-gradient(circle at 28% 28%, #d6e6f8, transparent 45%), linear-gradient(135deg, #e6edf5, #f8f6ef); }
.blog-card__visual--3 { background: radial-gradient(circle at 75% 28%, #e7d9c7, transparent 44%), linear-gradient(135deg, #f0e8dc, #f8f6ef); }
.blog-card__visual-index { position: relative; z-index: 1; font-size: 1.2rem; }
.blog-card__content { padding: 23px; }
.blog-card__category { margin: 0 0 12px; color: #6d873a; font-size: .7rem; font-weight: 750; letter-spacing: .11em; text-transform: uppercase; }
.blog-card h3 { margin: 0; font-size: 1.25rem; line-height: 1.35; letter-spacing: -.04em; }
.blog-card__content > p:not(.blog-card__category) { margin: 12px 0 21px; color: var(--muted); font-size: .87rem; line-height: 1.75; }
.blog-card .text-link { font-size: .8rem; }
.faq-section { background: #f7f6f2; }
.faq-layout { display: grid; grid-template-columns: minmax(260px, .75fr) minmax(0, 1.25fr); gap: clamp(40px, 8vw, 110px); align-items: start; }
.faq-intro .section-copy { margin-bottom: 22px; }
.faq-list { border-top: 1px solid var(--line); }
.faq-item { border-bottom: 1px solid var(--line); }
.faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 22px 0; cursor: pointer; list-style: none; font-size: .98rem; font-weight: 650; line-height: 1.5; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item__icon { display: grid; width: 30px; height: 30px; flex: 0 0 30px; place-items: center; border: 1px solid #d7dacd; border-radius: 50%; color: #627d31; font-size: 1.1rem; font-weight: 400; transition: transform 180ms ease; }
.faq-item[open] .faq-item__icon { transform: rotate(45deg); }
.faq-item > p { max-width: 650px; margin: -4px 40px 22px 0; color: var(--muted); font-size: .9rem; line-height: 1.8; }
.inquiry-section { background: #eeeee6; }
.inquiry-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(38px, 7vw, 90px); align-items: start; }
.inquiry-copy { padding-top: 22px; }
.inquiry-copy .section-copy { max-width: 560px; }
.inquiry-promise { display: inline-flex; align-items: center; gap: 12px; margin-top: 28px; color: #59634f; font-size: .82rem; }
.inquiry-form-wrap { padding: clamp(26px, 4vw, 42px); border: 1px solid rgb(32 37 31 / 8%); border-radius: 24px; background: #fffefa; box-shadow: 0 20px 60px rgb(32 37 31 / 5%); }
.inquiry-form-heading h3 { margin: 12px 0 0; font-size: 1.8rem; letter-spacing: -.05em; }
.inquiry-form-heading > p:last-child { margin: 9px 0 26px; color: var(--muted); font-size: .9rem; }
.inquiry-form { display: grid; gap: 18px; }
.inquiry-form label { display: grid; gap: 8px; color: #3d453a; font-size: .8rem; font-weight: 650; }
.inquiry-form input, .inquiry-form select { width: 100%; min-height: 48px; padding: 0 14px; border: 1px solid #dfe1d7; border-radius: 11px; outline: none; background: #fbfaf6; color: #20251f; font: inherit; font-size: .87rem; }
.inquiry-form input:focus, .inquiry-form select:focus { border-color: #91ab5e; box-shadow: 0 0 0 3px rgb(145 171 94 / 17%); }
.inquiry-form input::placeholder { color: #8a9085; }
.inquiry-form__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.inquiry-form__submit { justify-self: start; margin-top: 4px; }
.inquiry-form__notice { margin: 0; padding: 12px 14px; border-radius: 10px; background: #eef4e4; color: #405b25; font-size: .82rem; line-height: 1.6; }
.inquiry-form__fineprint { margin: 0; color: #777e72; font-size: .7rem; line-height: 1.6; }
.problem-carousel { display: grid; grid-template-columns: minmax(0, 1fr) 170px; gap: 24px; padding: 18px; border: 1px solid var(--line); border-radius: 24px; background: #fffefa; box-shadow: 0 20px 60px rgb(32 37 31 / 4%); }
.problem-carousel__main { display: grid; min-height: 310px; grid-template-columns: minmax(170px, .8fr) minmax(0, 1fr); align-items: center; gap: 20px; padding: 18px; border-radius: 17px; background: #f1f3e9; }
.problem-carousel--blue .problem-carousel__main { background: #edf2f8; }
.problem-carousel--lime .problem-carousel__main { background: #f2f3e7; }
.problem-carousel__meta { display: flex; grid-column: 1 / -1; justify-content: space-between; color: #68725e; font-family: var(--font-geist-mono), monospace; font-size: .7rem; }
.problem-carousel__art { position: relative; display: grid; min-height: 180px; place-items: center; overflow: hidden; }
.problem-carousel__ring { position: absolute; width: 145px; height: 145px; border: 1px solid rgb(91 117 57 / 28%); border-radius: 50%; }
.problem-carousel__ring--two { width: 105px; height: 105px; border-style: dashed; transform: rotate(34deg) scaleX(1.4); }
.problem-carousel__spark { position: relative; display: grid; width: 70px; height: 70px; place-items: center; border: 1px solid rgb(255 255 255 / 80%); border-radius: 24px; background: linear-gradient(145deg, #d8e9b3, #b9d88b); box-shadow: 0 16px 35px rgb(82 112 44 / 16%); color: #506a2d; font-size: 2rem; }
.problem-carousel--blue .problem-carousel__spark { background: linear-gradient(145deg, #dbe8f8, #b5cce9); color: #496b94; }
.problem-carousel__art-label { position: absolute; bottom: 0; color: #727a68; font-size: .66rem; letter-spacing: .04em; }
.problem-carousel__copy { max-width: 460px; padding: 10px 18px 10px 0; }
.problem-carousel__copy .eyebrow { margin-bottom: 14px; }
.problem-carousel__copy h3 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.5rem); line-height: 1.1; letter-spacing: -.06em; }
.problem-carousel__copy > p:last-child { margin: 16px 0 0; color: #5f675d; font-size: .95rem; line-height: 1.8; }
.problem-carousel__controls { display: flex; flex-direction: column; align-items: stretch; justify-content: space-between; padding: 15px 12px 14px 0; }
.problem-carousel__dots { display: grid; gap: 10px; }
.problem-carousel__dots button { display: flex; min-height: 49px; align-items: center; gap: 12px; padding: 0 12px; border: 1px solid transparent; border-radius: 12px; background: transparent; color: #6c7467; cursor: pointer; text-align: left; }
.problem-carousel__dots button::before { width: 7px; height: 7px; border-radius: 50%; background: #c4cbb8; content: ""; }
.problem-carousel__dots button.is-active { border-color: #dce2d0; background: #f3f5ed; color: #35422b; font-weight: 700; }
.problem-carousel__dots button.is-active::before { background: #789844; box-shadow: 0 0 0 4px rgb(120 152 68 / 15%); }
.problem-carousel__arrows { display: flex; justify-content: flex-end; gap: 8px; }
.problem-carousel__arrows button { display: grid; width: 43px; height: 43px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: #fffefa; cursor: pointer; font-size: 1.1rem; transition: background 180ms ease, transform 180ms ease; }
.problem-carousel__arrows button:hover { transform: translateY(-2px); background: #eef3e4; }

@media (max-width: 1000px) {
  .hero__content { grid-template-columns: minmax(0, 1fr) minmax(280px, .78fr); }
  .hero h1 { font-size: clamp(3rem, 5.8vw, 4.7rem); }
  .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .service-card:nth-child(5) { grid-column: auto; }
  .service-card:last-child { grid-column: 1 / -1; }
  .process-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .problem-carousel { grid-template-columns: 1fr; }
  .problem-carousel__controls { flex-direction: row; align-items: center; padding: 0 10px 8px; }
  .problem-carousel__dots { display: flex; flex-wrap: wrap; }
  .problem-carousel__dots button { min-height: 40px; }
}
@media (max-width: 700px) {
  .container, .site-header__inner { width: min(calc(100% - 36px), var(--container)); }
  .hero__content { grid-template-columns: 1fr; gap: 6px; padding-block: 54px 25px; }
  .hero h1 { font-size: clamp(2.75rem, 11.2vw, 4.5rem); line-height: 1.03; }
  .hero__description { font-size: .97rem; line-height: 1.75; }
  .hero__actions { align-items: flex-start; flex-direction: column; gap: 18px; }
  .hero-visual { width: min(100%, 360px); margin: 12px auto 0; }
  .intro-section__grid, .faq-layout, .inquiry-layout { grid-template-columns: 1fr; gap: 26px; }
  .section-heading { font-size: clamp(2.35rem, 9vw, 3.4rem); }
  .services-grid, .why-grid, .testimonial-grid, .blog-grid { grid-template-columns: 1fr; }
  .service-card, .service-card:last-child { grid-column: auto; min-height: 245px; }
  .process-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; margin-top: 34px; }
  .process-card { padding: 18px; }
  .process-card p { font-size: .82rem; }
  .why-card { min-height: unset; padding: 23px; }
  .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 25px 18px; }
  .stat-item:nth-child(2) { border-right: 0; }
  .client-logo-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .client-logo-row span:last-child { grid-column: 1 / -1; }
  .problem-carousel { padding: 10px; }
  .problem-carousel__main { grid-template-columns: 1fr; gap: 10px; padding: 16px; }
  .problem-carousel__meta { grid-column: auto; }
  .problem-carousel__art { min-height: 140px; }
  .problem-carousel__copy { padding: 8px 0 10px; }
  .problem-carousel__copy h3 { font-size: 1.9rem; }
  .problem-carousel__controls { align-items: flex-end; gap: 12px; padding: 8px 6px 5px; }
  .problem-carousel__dots { gap: 3px; }
  .problem-carousel__dots button { width: 35px; min-height: 35px; justify-content: center; padding: 0; font-size: 0; }
  .problem-carousel__dots button::before { width: 8px; height: 8px; }
  .inquiry-form-wrap { padding: 24px 18px; }
  .inquiry-form__row { grid-template-columns: 1fr; }
}
@media (max-width: 390px) {
  .process-grid { grid-template-columns: 1fr; }
  .stats-grid { gap: 22px 12px; }
  .stat-item strong { font-size: 2.2rem; }
}
@media (prefers-reduced-motion: reduce) {
  .service-card, .process-card, .why-card, .blog-card, .problem-carousel__arrows button { transition: none; }
}



/* DF HERO RIGHT-SIDE CAROUSEL */
.hero__carousel {
  width: 100%;
  min-width: 0;
  align-self: center;
  position: relative;
  z-index: 1;
}
.hero__carousel .problem-carousel {
  grid-template-columns: minmax(0, 1fr);
  gap: 8px;
  padding: 14px;
}
.hero__carousel .problem-carousel__main {
  min-height: 300px;
  grid-template-columns: minmax(105px, .72fr) minmax(0, 1fr);
  gap: 12px;
  padding: 16px;
}
.hero__carousel .problem-carousel__controls {
  flex-direction: row;
  align-items: center;
  gap: 12px;
  padding: 4px 2px 2px;
}
.hero__carousel .problem-carousel__dots {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.hero__carousel .problem-carousel__dots button {
  min-height: 36px;
  padding-inline: 10px;
}
@media (max-width: 640px) {
  .hero__carousel .problem-carousel__main {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .hero__carousel .problem-carousel__art {
    min-height: 115px;
  }
}



/* DF HERO IMAGE CAROUSEL */
.hero-visual--carousel {
  position: relative;
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14px;
  padding: 10px 0 0;
}
.hero-visual__frame {
  position: relative;
  width: 100%;
  aspect-ratio: 1.12 / 1;
  min-height: 360px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.82);
  border-radius: 28px;
  background: radial-gradient(circle at 70% 28%, #dbeafe 0, #f7faff 44%, #f5f3ff 100%);
  box-shadow: 0 24px 70px rgba(49, 88, 170, .13), inset 0 1px 0 rgba(255,255,255,.9);
}
.hero-visual__image {
  object-fit: contain;
  object-position: center;
  padding: 0;
  animation: hero-carousel-image-in .45s ease both;
}
.hero-visual__counter {
  position: absolute;
  z-index: 2;
  top: 16px;
  left: 16px;
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 999px;
  background: rgba(255,255,255,.82);
  color: #667085;
  font-size: 13px;
  backdrop-filter: blur(12px);
}
.hero-visual__counter strong { color: #245cff; }
.hero-visual__slide-label {
  position: absolute;
  z-index: 2;
  right: 16px;
  top: 16px;
  padding: 9px 14px;
  border-radius: 999px;
  color: #245cff;
  background: rgba(231,240,255,.9);
  font-size: 13px;
  font-weight: 650;
  box-shadow: 0 6px 20px rgba(48,91,180,.08);
}
.hero-visual__controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 0 4px;
}
.hero-visual__arrow {
  display: inline-grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 0;
  border-radius: 50%;
  cursor: pointer;
  font-size: 26px;
  line-height: 1;
  transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
}
.hero-visual__arrow:hover { transform: translateY(-2px); }
.hero-visual__arrow:focus-visible, .hero-visual__dots button:focus-visible { outline: 3px solid #245cff; outline-offset: 3px; }
.hero-visual__arrow--previous { color: #24334d; background: #e9eef8; }
.hero-visual__arrow--next { color: white; background: #245cff; box-shadow: 0 10px 24px rgba(36,92,255,.25); }
.hero-visual__dots { display: flex; align-items: center; justify-content: center; gap: 8px; }
.hero-visual__dots button { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 999px; background: #cbd5e1; cursor: pointer; transition: width .2s ease, background .2s ease; }
.hero-visual__dots button.is-active { width: 25px; background: #245cff; }
@keyframes hero-carousel-image-in { from { opacity: .65; transform: translateY(5px) scale(.99); } to { opacity: 1; transform: translateY(0) scale(1); } }
@media (max-width: 900px) {
  .hero-visual__frame { aspect-ratio: 1.15 / 1; min-height: 300px; }
}
@media (max-width: 640px) {
  .hero-visual--carousel { padding-top: 4px; }
  .hero-visual__frame { min-height: 0; aspect-ratio: 1 / 1; border-radius: 22px; }
  .hero-visual__arrow { width: 44px; height: 44px; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-visual__image { animation: none; }
  .hero-visual__arrow, .hero-visual__dots button { transition: none; }
}


/* ==========================================================
   DF PREMIUM PALETTE + SCROLL REVEALS v1
   Warm ivory / midnight ink / cobalt / mint
   Content remains visible by default; motion is progressive enhancement.
   ========================================================== */
:root {
  --background: #f6f7fb;
  --surface: #ffffff;
  --surface-soft: #edf1fb;
  --foreground: #17233b;
  --muted: #5e6b82;
  --line: #dfe5f0;
  --accent: #3d5fe8;
  --accent-strong: #2949cc;
  --blue: #e7edff;
  --ink: #17233b;
  --df-cobalt: #3d5fe8;
  --df-midnight: #17233b;
  --df-mint: #d9f5e9;
  --radius-card: 1.35rem;
}
html { scroll-behavior: smooth; scroll-padding-top: 96px; }
body {
  background: radial-gradient(ellipse at 8% 0%, rgba(61,95,232,.065), transparent 32rem), var(--background);
  color: var(--foreground);
}
::selection { color: #fff; background: var(--df-cobalt); }

/* Refined translucent navigation */
.site-header {
  background: rgba(246,247,251,.86);
  border-bottom-color: rgba(223,229,240,.8);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
}
.site-header a, .site-header button {
  transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
}
.site-header a:hover, .site-header button:hover { color: var(--df-cobalt); }
.button--primary, .button--nav {
  background: var(--df-cobalt);
  color: #fff;
  box-shadow: 0 10px 26px rgba(61,95,232,.19);
}
.button--primary:hover, .button--nav:hover {
  background: var(--accent-strong);
  color: #fff;
  box-shadow: 0 14px 30px rgba(61,95,232,.25);
  transform: translateY(-2px);
}
.text-link, .hero__headline-accent, .hero__head-line-accent, .text-accent { color: var(--df-cobalt); }

/* A soft blue atmosphere and a mint counterpoint in the hero */
.hero {
  background:
    radial-gradient(ellipse at 82% 22%, rgba(61,95,232,.12), transparent 26rem),
    radial-gradient(ellipse at 74% 76%, rgba(217,245,233,.7), transparent 22rem),
    var(--background);
}
.hero__ambient { opacity: .78; }
.hero__grid {
  opacity: .3;
  background-image: linear-gradient(rgba(61,95,232,.055) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(61,95,232,.055) 1px, transparent 1px);
}
.hero__orb-one { background: rgba(61,95,232,.12); filter: blur(2px); }
.hero__orb-two { background: rgba(217,245,233,.85); }
.hero__eyebrow { background: rgba(255,255,255,.8); border-color: rgba(61,95,232,.18); }
.status-dot, .hero-visual__label-dot {
  background: var(--df-cobalt);
  box-shadow: 0 0 0 5px rgba(61,95,232,.1);
}
.hero__note-line { background: var(--df-cobalt); }
.hero__bottom a { border-color: rgba(61,95,232,.24); color: var(--df-cobalt); }

/* Cards use consistent depth, contrast and accent treatment */
.intro-section { background: linear-gradient(180deg, rgba(231,237,255,.38), transparent); }
.services-section { background: linear-gradient(180deg, #f6f7fb 0%, #fff 50%, #f6f7fb 100%); }
.service-card {
  border-color: var(--line);
  background: rgba(255,255,255,.9);
  box-shadow: 0 8px 28px rgba(23,35,59,.035);
  transition: transform 240ms cubic-bezier(.2,.8,.2,1), border-color 240ms ease, box-shadow 240ms ease;
}
.service-card:hover {
  transform: translateY(-6px);
  border-color: rgba(61,95,232,.36);
  box-shadow: 0 18px 42px rgba(23,35,59,.09);
}
.service-card__number, .process-card__number { color: var(--df-cobalt); }
.service-card__tag { border-color: rgba(61,95,232,.18); background: #f1f4ff; color: #344fc3; }
.process-card__rule { background: linear-gradient(90deg, var(--df-cobalt), rgba(61,95,232,.12)); }

/* One intentional dark section gives the page editorial rhythm */
.approach-section { background: var(--df-midnight); color: #f8faff; }
.approach-section .section-heading, .approach-section h3 { color: #f8faff; }
.approach-section .section-copy, .approach-section .process-card p { color: #c2cce0; }
.approach-section .eyebrow, .approach-section .process-card__number { color: #aebdff; }
.approach-section .process-card__rule { background: linear-gradient(90deg, #8298ff, rgba(130,152,255,.15)); }
.button--light, .footer-cta { background: var(--df-mint); color: var(--df-midnight); }
.button--light:hover, .footer-cta:hover { background: #c4eddd; color: var(--df-midnight); }
.site-footer { background: #eef1f8; border-top: 1px solid var(--line); }
.site-footer__links > a:hover { color: var(--df-cobalt); }

/* Scroll reveals: normal visible layout is the fallback */
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .intro-section .intro-section__grid,
    .services-section .section-header,
    .approach-section .section-header,
    .service-card,
    .process-card {
      animation: df-rise-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 42%;
    }
    .service-card:nth-child(2), .process-card:nth-child(2) { animation-range: entry 0% entry 48%; }
    .service-card:nth-child(3), .process-card:nth-child(3) { animation-range: entry 0% entry 54%; }
  }
}
@keyframes df-rise-in {
  from { opacity: .18; transform: translateY(28px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
  .service-card, .process-card, .intro-section__grid, .section-header {
    animation: none !important;
    animation-timeline: auto !important;
    opacity: 1 !important;
    transform: none !important;
  }
}


/* DF HERO MOTION ENHANCEMENT v1 */

/* A subtle entrance for supporting hero content */
.hero__description,
.hero__actions,
.hero__note {
  opacity: 0;
  animation: hero-support-arrive 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero__description {
  animation-delay: 480ms;
}

.hero__actions {
  animation-delay: 620ms;
}

.hero__note {
  animation-delay: 760ms;
}

@keyframes hero-support-arrive {
  from {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

/* Highlight sweep on the key phrase */
.hero__headline-accent {
  position: relative;
  display: inline;
  background-image: linear-gradient(
    90deg,
    currentColor 0%,
    currentColor 48%,
    rgba(255, 255, 255, 0.78) 50%,
    currentColor 53%,
    currentColor 100%
  );
  background-size: 230% 100%;
  background-position: 100% 0;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: hero-accent-sweep 1100ms ease-out 650ms infinite; animation-delay: 1s;
}

@keyframes hero-accent-sweep {
  from {
    background-position: 100% 0;
  }

  to {
    background-position: 0 0;
  }
}

/* Keep the complete hero visible for visitors who prefer less motion */
@media (prefers-reduced-motion: reduce) {
  .hero__description,
  .hero__actions,
  .hero__note,
  .hero__headline-accent {
    animation: none !important;
    opacity: 1;
    transform: none;
    background-image: none;
    -webkit-text-fill-color: currentColor;
  }
}


/* DF POLISHED KINETIC LOOP v2 */

/* Gentle, continuous movement. Text stays visible at all times. */
.hero-title__word {
  animation-name: hero-word-kinetic-loop !important;
  animation-duration: 5.6s !important;
  animation-timing-function: ease-in-out !important;
  animation-iteration-count: infinite !important;
  animation-fill-mode: both !important;
  will-change: transform;
}

@keyframes hero-word-kinetic-loop {
  0%, 100% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    filter: none;
  }

  18% {
    opacity: 1;
    transform: translate3d(0, -3px, 0);
    filter: none;
  }

  36% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    filter: none;
  }

  70% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    filter: none;
  }
}

/* Remove the fast, repeating gradient sweep; use a quiet accent glow. */
.hero__headline-accent {
  background-image: none !important;
  background-clip: border-box !important;
  -webkit-background-clip: border-box !important;
  -webkit-text-fill-color: currentColor !important;
  animation: hero-accent-kinetic-loop 5.6s ease-in-out infinite !important;
}

@keyframes hero-accent-kinetic-loop {
  0%, 100% {
    text-shadow: 0 0 0 rgba(61, 95, 232, 0);
  }

  35% {
    text-shadow: 0 0 10px rgba(61, 95, 232, 0.12);
  }

  60% {
    text-shadow: 0 0 0 rgba(61, 95, 232, 0);
  }
}

/* Supporting copy and buttons must not participate in the loop. */
.hero__description,
.hero__actions,
.hero__note {
  animation-iteration-count: 1;
  animation-fill-mode: both;
}

/* Honor accessibility preferences. */
@media (prefers-reduced-motion: reduce) {
  .hero-title__word,
  .hero__headline-accent,
  .hero__description,
  .hero__actions,
  .hero__note {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
    text-shadow: none !important;
    will-change: auto;
  }
}


/* DF EDITORIAL HERO ANIMATION v3 */

/* Remove the previous kinetic loops and entrance effects. */
.hero-title__word {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
  will-change: auto !important;
}

.hero__description,
.hero__actions,
.hero__note {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
}

/* Restore the accent text and remove its old animated glow. */
.hero__headline-accent {
  position: relative;
  background: none !important;
  background-image: none !important;
  background-clip: border-box !important;
  -webkit-background-clip: border-box !important;
  -webkit-text-fill-color: currentColor !important;
  text-shadow: none !important;
  animation: none !important;
}

/* A restrained line draws beneath the key phrase. */
.hero__headline-accent::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -0.1em;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left center;
  animation: df-editorial-line 5s ease-in-out infinite;
  pointer-events: none;
}

@keyframes df-editorial-line {
  0%, 8% {
    transform: scaleX(0);
    opacity: 0.55;
  }

  28%, 72% {
    transform: scaleX(1);
    opacity: 0.8;
  }

  92%, 100% {
    transform: scaleX(0);
    opacity: 0.55;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__headline-accent::after {
    animation: none !important;
    transform: scaleX(1);
  }
}


/* DF WORD SHIMMER v4 */

/* Remove the previous underline and all earlier hero loops. */
.hero__headline-accent::after {
  content: none !important;
  animation: none !important;
}

.hero-title__word {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
  will-change: auto !important;
}

.hero__description,
.hero__actions,
.hero__note {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
}

/* A soft highlight travels across the accent phrase. */
.hero__headline-accent {
  background-image: linear-gradient(
    110deg,
    currentColor 0%,
    currentColor 42%,
    #829cff 48%,
    #ffffff 50%,
    #829cff 52%,
    currentColor 58%,
    currentColor 100%
  ) !important;
  background-size: 250% 100% !important;
  background-position: 100% 0 !important;
  background-clip: text !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  text-shadow: none !important;
  animation: df-word-shimmer 5s ease-in-out infinite !important;
}

@keyframes df-word-shimmer {
  0%, 12% {
    background-position: 100% 0;
  }

  52%, 72% {
    background-position: 0 0;
  }

  100% {
    background-position: 100% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__headline-accent {
    animation: none !important;
    background-image: none !important;
    -webkit-text-fill-color: currentColor !important;
  }
}


/* DF FLOATING LETTERS v5 */

/* Remove the shimmer and underline that crossed the headline. */
.hero__headline-accent,
.hero-title__word {
  animation: none !important;
  background: none !important;
  -webkit-text-fill-color: currentColor !important;
  text-shadow: none !important;
  filter: none !important;
  opacity: 1 !important;
  transform: none !important;
  will-change: auto !important;
}

.hero__headline-accent::before,
.hero__headline-accent::after {
  content: none !important;
  animation: none !important;
}

.hero__description,
.hero__actions,
.hero__note {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
}

/* Decorative letters float beside the heading, not over the text. */
.hero__copy {
  position: relative;
}

.hero__copy::after {
  content: "D  ÃƒÆ’Ã‚Â¢Ãƒâ€¦Ã¢â‚¬Å“Ãƒâ€šÃ‚Â¦  M";
  position: absolute;
  top: 20%;
  right: -2px;
  z-index: 2;
  color: var(--df-cobalt, #3d5fe8);
  font-size: 0.78rem;
  font-weight: 750;
  letter-spacing: 0.2em;
  opacity: 0.68;
  pointer-events: none;
  animation: df-floating-letters 4s ease-in-out infinite;
}

@keyframes df-floating-letters {
  0%, 100% {
    transform: translate3d(0, 0, 0) rotate(-4deg);
    opacity: 0.55;
  }

  50% {
    transform: translate3d(0, -9px, 0) rotate(4deg);
    opacity: 0.95;
  }
}

@media (max-width: 760px) {
  .hero__copy::after {
    top: 10%;
    right: 2px;
    font-size: 0.68rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__copy::after {
    animation: none !important;
  }
}


/* DF CHARACTER MOTION + HERO FIT v6 */

/* Disable previous shimmer, underline, and decorative pseudo-effects. */
.hero__headline-accent,
.hero-title__word {
  animation: none !important;
  background: none !important;
  -webkit-text-fill-color: currentColor !important;
  text-shadow: none !important;
  filter: none !important;
  opacity: 1 !important;
  transform: none !important;
  will-change: auto !important;
}

.hero__headline-accent::before,
.hero__headline-accent::after,
.hero__copy::before,
.hero__copy::after {
  content: none !important;
  animation: none !important;
}

.hero__description,
.hero__actions,
.hero__note {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
}

/* Three independent character accents, outside the headline. */
.hero-character-motif {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 34px;
  margin: 12px 0 8px;
  color: var(--df-cobalt, #3d5fe8);
  pointer-events: none;
}

.hero-character {
  display: inline-block;
  font-size: 1.05rem;
  line-height: 1;
  font-weight: 800;
  animation: df-character-float 3.6s ease-in-out infinite;
}

.hero-character--d {
  animation-delay: 0ms;
}

.hero-character--spark {
  font-size: 0.9rem;
  animation-delay: 420ms;
}

.hero-character--m {
  animation-delay: 840ms;
}

@keyframes df-character-float {
  0%, 100% {
    transform: translateY(0) rotate(0);
    opacity: 0.62;
  }

  50% {
    transform: translateY(-5px) rotate(5deg);
    opacity: 1;
  }
}

/* Prevent the right column from exceeding the available grid width. */
.hero__content {
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr) !important;
}

.hero__copy,
.hero__carousel,
.hero-visual--carousel {
  min-width: 0;
  max-width: 100%;
}

.hero-visual--carousel {
  width: 100%;
  justify-self: end;
}

.hero-visual__frame {
  width: 100%;
  min-width: 0;
}

@media (max-width: 1000px) {
  .hero__content {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr) !important;
  }
}

@media (max-width: 700px) {
  .hero__content {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .hero-visual--carousel {
    justify-self: center;
  }

  .hero-character-motif {
    margin-top: 8px;
    margin-bottom: 6px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-character {
    animation: none !important;
    transform: none !important;
    opacity: 0.85;
  }
}


/* Remove DF floating character decorations */
.hero-character-motif,
.hero-character {
  display: none !important;
  animation: none !important;
}

/* =========================================================
   DF DIGITAL ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â LIVING DIGITAL ATMOSPHERE
   CSS-only gradients, grid, floating forms and light effects
   ========================================================= */

:root {
  --df-atmosphere-blue: 61, 95, 232;
  --df-atmosphere-mint: 133, 222, 190;
  --df-atmosphere-ink: #17233b;
}

/* A subtle atmospheric canvas behind the whole website */
html {
  scroll-behavior: smooth;
}

body {
  isolation: isolate;
  background:
    radial-gradient(
      ellipse at 8% 4%,
      rgba(var(--df-atmosphere-blue), 0.075),
      transparent 34rem
    ),
    radial-gradient(
      ellipse at 94% 35%,
      rgba(var(--df-atmosphere-mint), 0.12),
      transparent 32rem
    ),
    #f8f9fc;
}

/* Fixed background texture: decorative, never interactive */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image:
    linear-gradient(
      rgba(var(--df-atmosphere-blue), 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(var(--df-atmosphere-blue), 0.035) 1px,
      transparent 1px
    );
  background-size: 54px 54px;
  opacity: 0.52;
  mask-image: linear-gradient(
    to bottom,
    black 0%,
    rgba(0, 0, 0, 0.65) 38%,
    transparent 90%
  );
  animation: df-grid-drift 36s linear infinite;
}

/* Soft ambient light drifting behind the content */
body::after {
  content: "";
  position: fixed;
  inset: -18%;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(
      ellipse at 18% 28%,
      rgba(var(--df-atmosphere-blue), 0.105),
      transparent 25%
    ),
    radial-gradient(
      ellipse at 82% 64%,
      rgba(var(--df-atmosphere-mint), 0.16),
      transparent 24%
    );
  filter: blur(38px);
  opacity: 0.75;
  animation: df-atmosphere-breathe 16s ease-in-out infinite alternate;
}

/* Keep the existing hero carousel and content above its background */
.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background:
    radial-gradient(
      ellipse at 76% 22%,
      rgba(var(--df-atmosphere-blue), 0.16),
      transparent 29rem
    ),
    radial-gradient(
      ellipse at 80% 82%,
      rgba(var(--df-atmosphere-mint), 0.27),
      transparent 24rem
    ),
    transparent;
}

/* Existing decorative hero canvas */
.hero__ambient {
  position: absolute;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}

/* Floating light forms */
.hero__orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  will-change: transform;
}

.hero__orb--one {
  background: radial-gradient(
    circle at 32% 28%,
    rgba(126, 155, 255, 0.36),
    rgba(var(--df-atmosphere-blue), 0.10) 48%,
    transparent 72%
  );
  animation: df-orb-float-one 13s ease-in-out infinite alternate;
}

.hero__orb--two {
  background: radial-gradient(
    circle at 38% 34%,
    rgba(211, 255, 236, 0.68),
    rgba(var(--df-atmosphere-mint), 0.16) 52%,
    transparent 73%
  );
  animation: df-orb-float-two 17s ease-in-out infinite alternate;
}

/* Animate the existing grid without introducing another canvas */
.hero__grid {
  background-position: 0 0;
  animation: df-grid-drift 42s linear infinite;
  will-change: background-position;
}

/* Three-dimensional orbital rings, made entirely with CSS */
.hero__ambient::before,
.hero__ambient::after {
  content: "";
  position: absolute;
  width: clamp(220px, 33vw, 470px);
  aspect-ratio: 1;
  border: 1px solid rgba(var(--df-atmosphere-blue), 0.13);
  border-radius: 50%;
  pointer-events: none;
}

.hero__ambient::before {
  top: 8%;
  right: -7%;
  box-shadow:
    inset 0 0 55px rgba(var(--df-atmosphere-blue), 0.045),
    0 0 65px rgba(var(--df-atmosphere-blue), 0.045);
  transform: rotateX(64deg) rotateZ(-22deg);
  animation: df-ring-float 19s ease-in-out infinite alternate;
}

.hero__ambient::after {
  right: 12%;
  bottom: -37%;
  width: clamp(190px, 25vw, 340px);
  border-color: rgba(var(--df-atmosphere-mint), 0.27);
  transform: rotateX(66deg) rotateZ(28deg);
  animation: df-ring-float 15s ease-in-out infinite alternate-reverse;
}

/* Gentle depth and movement */
@keyframes df-grid-drift {
  from {
    background-position: 0 0;
  }
  to {
    background-position: 54px 54px;
  }
}

@keyframes df-atmosphere-breathe {
  0% {
    transform: translate3d(-1%, -1%, 0) scale(0.98);
    opacity: 0.55;
  }
  50% {
    opacity: 0.85;
  }
  100% {
    transform: translate3d(2%, 1%, 0) scale(1.04);
    opacity: 0.68;
  }
}

@keyframes df-orb-float-one {
  0% {
    transform: translate3d(-8px, 5px, 0) scale(0.96);
  }
  50% {
    transform: translate3d(24px, -20px, 0) scale(1.05);
  }
  100% {
    transform: translate3d(-12px, 18px, 0) scale(1.09);
  }
}

@keyframes df-orb-float-two {
  0% {
    transform: translate3d(12px, -8px, 0) scale(1);
  }
  50% {
    transform: translate3d(-22px, 16px, 0) scale(1.08);
  }
  100% {
    transform: translate3d(15px, 24px, 0) scale(0.96);
  }
}

@keyframes df-ring-float {
  0% {
    translate: 0 0;
    rotate: -5deg;
  }
  100% {
    translate: -16px 20px;
    rotate: 7deg;
  }
}

/* Mobile: keep the atmosphere lighter and avoid oversized shapes */
@media (max-width: 760px) {
  body::before {
    background-size: 38px 38px;
    opacity: 0.3;
  }

  body::after {
    filter: blur(24px);
    opacity: 0.55;
  }

  .hero__ambient::before {
    top: 12%;
    right: -42%;
    width: 270px;
  }

  .hero__ambient::after {
    right: -12%;
    bottom: -15%;
    width: 220px;
  }

  .hero__grid {
    opacity: 0.2;
  }
}

/* Accessibility: remove motion for visitors who request it */
@media (prefers-reduced-motion: reduce) {
  body::before,
  body::after,
  .hero__orb--one,
  .hero__orb--two,
  .hero__grid,
  .hero__ambient::before,
  .hero__ambient::after {
    animation: none !important;
    will-change: auto;
  }

  html {
    scroll-behavior: auto;
  }
}
/* Hero background uses the original static theme; no temporary animation test. */
.hero__description--multicolor {
  line-height: 1.85;
}

.hero__colored-word {
  display: inline;
  font-weight: 500;
  transition: color 0.3s ease;
}

.hero__colored-word--0 { color: #3d5fe8; }
.hero__colored-word--1 { color: #008f83; }
.hero__colored-word--2 { color: #a34bc7; }
.hero__colored-word--3 { color: #e56c42; }
.hero__colored-word--4 { color: #168c58; }
.hero__colored-word--5 { color: #c04d85; }
.hero__colored-word--6 { color: #2862a8; }
.hero__colored-word--7 { color: #9a641e; }

.hero__colored-word:hover {
  color: #17233b;
}
/* FORCE individual word colors in the hero description */
.hero p.hero__description--multicolor .hero__colored-word {
  color: var(--word-color) !important;
  -webkit-text-fill-color: var(--word-color) !important;
  opacity: 1 !important;
}

/* Hero description ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â all words white */
.hero p.hero__description--multicolor .hero__colored-word {
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
  opacity: 1 !important;
}
/* DF Digital ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â kinetic hero typography */

.hero-title--kinetic {
  perspective: 900px;
}

.hero-title--kinetic .hero-title__line {
  display: block;
  overflow: visible;
}

.hero-title--kinetic .hero-title__word {
  display: inline-block;
  opacity: 0;
  transform: translate3d(0, 32px, 0) rotateX(-8deg);
  animation: df-title-reveal 900ms
    cubic-bezier(0.2, 0.75, 0.25, 1) forwards;
}

.hero-title__word--line-one {
  animation-delay: 100ms !important;
}

.hero-title__word--line-two {
  animation-delay: 320ms !important;
}

.hero-title__word--line-three {
  animation-delay: 540ms !important;
}

.hero-word {
  display: inline-block;
  transition:
    color 300ms ease,
    transform 300ms ease,
    text-shadow 300ms ease;
}

.hero-word--white {
  color: #ffffff;
}

.hero-word--blue {
  color: #82a7ff;
  text-shadow: 0 0 22px rgb(80 120 255 / 18%);
}

.hero-word--gradient {
  background: linear-gradient(
    100deg,
    #8ba5ff 0%,
    #c3a5ff 45%,
    #78e1ee 75%,
    #8ba5ff 100%
  );
  background-size: 220% auto;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: df-gradient-flow 5s ease-in-out infinite;
}

.hero-word--mint {
  color: #8ce8c0;
  text-shadow: 0 0 24px rgb(92 231 177 / 15%);
}

@keyframes df-title-reveal {
  from {
    opacity: 0;
    transform: translate3d(0, 32px, 0) rotateX(-8deg);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotateX(0);
  }
}

@keyframes df-gradient-flow {
  0%,
  100% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }
}

@media (hover: hover) {
  .hero-title--kinetic .hero-word:hover {
    transform: translateY(-3px);
  }

  .hero-title--kinetic .hero-word--blue:hover {
    text-shadow: 0 0 25px rgb(100 145 255 / 65%);
  }

  .hero-title--kinetic .hero-word--mint:hover {
    text-shadow: 0 0 25px rgb(92 231 177 / 55%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-title--kinetic .hero-title__word {
    opacity: 1;
    transform: none;
    animation: none;
  }

  .hero-word--gradient {
    animation: none;
    background-position: 50% 50%;
  }

  .hero-word {
    transition: none;
  }
}
/* DF Digital hero contrast fix */
.hero .hero__note,
.hero .hero__note > span:last-child,
.hero .hero__bottom,
.hero .hero__bottom > span,
.hero .hero__actions .text-link {
  color: #fff !important;
}

.hero .hero__note-line {
  background: #d6e4ff !important;
}

.hero .hero__bottom a {
  color: #fff !important;
  border-color: rgba(255,255,255,.5) !important;
}

.hero .hero-title--kinetic .hero-word--white {
  color: #fff !important;
  -webkit-text-fill-color: #fff !important;
}

.hero .hero-title--kinetic .hero-word--blue {
  color: #b8d0ff !important;
  -webkit-text-fill-color: #b8d0ff !important;
}

.hero .hero-title--kinetic .hero-word--gradient {
  background: linear-gradient(100deg,#fff,#b9caff,#d9c0ff,#fff);
  background-size: 220% auto;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero .hero-title--kinetic .hero-word--mint {
  color: #a6ffe0 !important;
  -webkit-text-fill-color: #a6ffe0 !important;
}

.hero .hero-title--kinetic .hero-title__word {
  animation: df-headline-enter 800ms ease-out both;
}

.hero .hero-title--kinetic .hero-title__word--line-one { animation-delay: 100ms; }
.hero .hero-title--kinetic .hero-title__word--line-two { animation-delay: 300ms; }
.hero .hero-title--kinetic .hero-title__word--line-three { animation-delay: 500ms; }

@keyframes df-headline-enter {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Rounded navbar and page spacing */
.site-header { position: sticky; top: 12px; z-index: 1000; width: calc(100% - 48px); max-width: 1440px; margin: 12px auto 0; border: 1px solid rgba(255,255,255,.65); border-radius: 22px; background: rgba(255,255,255,.88); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 8px 30px rgba(23,35,59,.08); }
.site-header__inner { padding-left: clamp(18px,3vw,42px); padding-right: clamp(18px,3vw,42px); }
.container, .section-shell > .container { width: min(100% - 64px,1320px); margin-left: auto; margin-right: auto; }
.hero.section-shell { margin-left: 24px; margin-right: 24px; border-radius: 28px; overflow: clip; }
@media (max-width:760px) { .site-header { top: 8px; width: calc(100% - 24px); margin-top: 8px; border-radius: 17px; } .site-header__inner { padding-left: 16px; padding-right: 16px; } .container, .section-shell > .container { width: calc(100% - 36px); } .hero.section-shell { margin-left: 12px; margin-right: 12px; border-radius: 22px; } }

/* Layout alignment refinement */
.site-header { box-sizing: border-box; width: calc(100% - 56px); max-width: 1600px; margin: 14px auto 16px; top: 0; }
.hero.section-shell { box-sizing: border-box; width: calc(100% - 56px); max-width: 1600px; margin: 0 auto 32px; border-radius: 28px; }
.hero .container { box-sizing: border-box; width: calc(100% - 80px); max-width: 1440px; margin-left: auto; margin-right: auto; }
.hero-title--kinetic { font-size: clamp(3.1rem, 4.5vw, 5.2rem); line-height: 1.02; letter-spacing: -0.065em; }
@media (max-width: 760px) { .site-header, .hero.section-shell { width: calc(100% - 24px); } .site-header { margin: 8px auto 12px; } .hero.section-shell { margin: 0 auto 24px; border-radius: 20px; } .hero .container { width: calc(100% - 36px); } .hero-title--kinetic { font-size: clamp(2.5rem, 9vw, 3.5rem); } }

/* SERVICE CARD HOVER REVEAL V1 */
.services-grid { align-items: stretch; }

.service-card {
  --card-accent: #4263eb;
  --card-tint: #edf2ff;
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 230px;
  padding: 26px;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--card-accent) 24%, white);
  border-radius: 24px;
  background: linear-gradient(145deg, #fff 30%, var(--card-tint));
  box-shadow: 0 12px 34px rgba(24,39,75,.05);
  text-decoration: none;
  transition: min-height .35s ease, border-color .3s ease,
    box-shadow .3s ease, transform .3s ease;
}

.service-card:nth-child(7n + 2) { --card-accent:#8b5cf6; --card-tint:#f3edff; }
.service-card:nth-child(7n + 3) { --card-accent:#e87942; --card-tint:#fff0e7; }
.service-card:nth-child(7n + 4) { --card-accent:#0891b2; --card-tint:#e7f9fc; }
.service-card:nth-child(7n + 5) { --card-accent:#0d9488; --card-tint:#e5f8f3; }
.service-card:nth-child(7n + 6) { --card-accent:#d9468f; --card-tint:#fff0f7; }
.service-card:nth-child(7n + 7) { --card-accent:#65a30d; --card-tint:#f2f9e6; }

.service-card::before {
  content:"";
  position:absolute;
  width:150px;
  height:150px;
  right:-70px;
  bottom:-90px;
  border-radius:50%;
  background:var(--card-tint);
  pointer-events:none;
  transition:transform .4s ease;
}

.service-card__top,
.service-card__body,
.service-card__cta {
  position:relative;
  z-index:1;
}

.service-card__number { color:var(--card-accent); font-weight:700; }
.service-card__tag {
  color:var(--card-accent);
  background:var(--card-tint);
  border-color:color-mix(in srgb, var(--card-accent) 25%, white);
}

.service-card__body { margin-top:14px; }
.service-card__body h3 {
  margin:0;
  color:#18243c;
  font-size:clamp(1.1rem, 1.4vw, 1.4rem);
  line-height:1.3;
  letter-spacing:-.035em;
}
.service-card__body p {
  margin:12px 0 0;
  color:#536078;
  line-height:1.7;
  opacity:0;
  max-height:0;
  overflow:hidden;
  transform:translateY(8px);
  transition:opacity .25s ease, transform .3s ease, max-height .35s ease;
}
.service-card__cta {
  display:flex;
  align-items:center;
  gap:10px;
  margin-top:auto;
  padding-top:16px;
  color:var(--card-accent);
  font-weight:700;
  opacity:0;
  transform:translateY(8px);
  transition:opacity .25s ease, transform .3s ease;
}

@media (hover:hover) and (min-width:761px) {
  .service-card:hover,
  .service-card:focus-visible {
    min-height:330px;
    border-color:var(--card-accent);
    box-shadow:0 22px 48px color-mix(in srgb, var(--card-accent) 16%, transparent);
    transform:translateY(-4px);
  }
  .service-card:hover::before,
  .service-card:focus-visible::before { transform:scale(1.6); }
  .service-card:hover .service-card__body p,
  .service-card:focus-visible .service-card__body p {
    opacity:1;
    max-height:180px;
    transform:translateY(0);
  }
  .service-card:hover .service-card__cta,
  .service-card:focus-visible .service-card__cta {
    opacity:1;
    transform:translateY(0);
  }
}

.service-card:focus-visible {
  outline:3px solid var(--card-accent);
  outline-offset:3px;
}

@media (hover:none), (max-width:760px) {
  .service-card { min-height:0; }
  .service-card__body p { max-height:none; opacity:1; transform:none; }
  .service-card__cta { opacity:1; transform:none; }
}

@media (prefers-reduced-motion:reduce) {
  .service-card,
  .service-card::before,
  .service-card__body p,
  .service-card__cta { transition:none !important; }
}

/* SERVICE CARD HOVER FIX V2 */
@media (min-width: 761px) {
.services-grid .service-card { min-height: 230px !important; background: linear-gradient(145deg, #ffffff 0%, var(--card-tint) 100%) !important; border: 1px solid color-mix(in srgb, var(--card-accent) 42%, white) !important; }
.services-grid .service-card__body p { opacity: 0 !important; max-height: 0 !important; overflow: hidden !important; transform: translateY(10px) !important; }
.services-grid .service-card__cta { opacity: 0 !important; transform: translateY(8px) !important; }
.services-grid .service-card:hover, .services-grid .service-card:focus-visible { min-height: 330px !important; background: linear-gradient(145deg, #ffffff 0%, var(--card-tint) 100%) !important; border-color: var(--card-accent) !important; box-shadow: 0 22px 48px color-mix(in srgb, var(--card-accent) 24%, transparent) !important; transform: translateY(-4px) !important; }
.services-grid .service-card:hover .service-card__body p, .services-grid .service-card:focus-visible .service-card__body p { opacity: 1 !important; max-height: 180px !important; transform: translateY(0) !important; }
.services-grid .service-card:hover .service-card__cta, .services-grid .service-card:focus-visible .service-card__cta { opacity: 1 !important; transform: translateY(0) !important; }
}
@media (max-width: 760px) { .services-grid .service-card__body p, .services-grid .service-card__cta { opacity: 1 !important; max-height: none !important; transform: none !important; } }

/* PROCESS CARD COLOR REFINEMENT V1 */
.approach-section .process-card {
  --process-accent: #91aaff;
  --process-tint: #25365b;
  background: linear-gradient(145deg, #202d49, var(--process-tint)) !important;
  border: 1px solid color-mix(in srgb, var(--process-accent) 45%, transparent) !important;
  border-radius: 22px !important;
  box-shadow: 0 12px 30px rgba(0,0,0,.12);
  transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
}
.approach-section .process-card:nth-child(6n + 2) { --process-accent:#c4a5ff; --process-tint:#332b57; }
.approach-section .process-card:nth-child(6n + 3) { --process-accent:#7ee7dc; --process-tint:#203f4c; }
.approach-section .process-card:nth-child(6n + 4) { --process-accent:#ffad91; --process-tint:#49313d; }
.approach-section .process-card:nth-child(6n + 5) { --process-accent:#ffd27d; --process-tint:#493c32; }
.approach-section .process-card:nth-child(6n + 6) { --process-accent:#a9e68a; --process-tint:#2b443c; }

.approach-section .process-card__number {
  color: var(--process-accent) !important;
  font-weight: 700;
}
.approach-section .process-card__rule {
  background: linear-gradient(90deg, var(--process-accent), transparent) !important;
  opacity: .9;
}
.approach-section .process-card h3 {
  color: #ffffff !important;
}
.approach-section .process-card p {
  color: #e0e7f4 !important;
  line-height: 1.75;
}
.approach-section .process-card:hover {
  transform: translateY(-5px);
  border-color: var(--process-accent) !important;
  box-shadow: 0 22px 42px rgba(0,0,0,.22);
}
@media (prefers-reduced-motion: reduce) {
  .approach-section .process-card { transition: none !important; }
}

/* PROCESS STAGGERED SCROLL REVEAL */
.approach-section .process-card--reveal {
  opacity: 0;
  transform: translateY(26px) scale(.985);
  transition:
    opacity 600ms ease,
    transform 600ms cubic-bezier(.2,.7,.2,1),
    border-color 280ms ease,
    box-shadow 280ms ease;
}
.approach-section .process-card--reveal.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}
@media (prefers-reduced-motion: reduce) {
  .approach-section .process-card--reveal,
  .approach-section .process-card--reveal.is-visible {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
/* CINEMATIC CAMPAIGN CAROUSEL */
.campaign-carousel__stage {
  position: relative;
  isolation: isolate;
  overflow: visible !important;
  border-radius: 28px;
  box-shadow: 0 28px 70px rgba(55, 45, 110, 0.18);
}

.hero-visual--carousel {
  overflow: visible;
}

.campaign-carousel__stage .hero-visual__image {
  z-index: 2;
  border-radius: 28px;
  animation: campaign-image-enter 650ms ease both;
}

.campaign-side-image {
  position: absolute;
  top: 5%;
  width: 40%;
  height: 90%;
  object-fit: cover;
  border-radius: 24px;
  opacity: 0.7;
  filter: saturate(0.8);
  z-index: 1;
  box-shadow: 0 20px 50px rgba(40, 35, 90, 0.16);
  pointer-events: none;
}

.campaign-side-image--previous {
  left: -24%;
  transform: scale(0.84) rotate(-4deg);
}

.campaign-side-image--next {
  right: -24%;
  transform: scale(0.84) rotate(4deg);
}

@keyframes campaign-image-enter {
  from {
    opacity: 0.55;
    transform: scale(0.97) translateY(8px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.hero-visual__controls {
  position: relative;
  z-index: 4;
}

.hero-visual__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.hero-visual__dot {
  width: 7px;
  height: 7px;
  padding: 0;
  border: 0;
  border-radius: 99px;
  background: rgba(100, 100, 120, 0.35);
  cursor: pointer;
  transition: width 220ms ease, background 220ms ease;
}

.hero-visual__dot.is-active {
  width: 23px;
  background: #7167d8;
}

@media (max-width: 760px) {
  .campaign-side-image {
    opacity: 0.4;
    width: 32%;
  }

  .campaign-side-image--previous {
    left: -13%;
  }

  .campaign-side-image--next {
    right: -13%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .campaign-carousel__stage .hero-visual__image {
    animation: none;
  }
}
/* PREMIUM APPROACH SECTION ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â COLOR REFINEMENT */
:root {
  --approach-bg: #f1f0ff;
  --approach-ink: #192544;
  --approach-accent: #6457e8;
  --approach-border: #dedcff;
}

.process-grid,
.approach-grid {
  gap: 20px;
}

.process-card,
.approach-card {
  background: linear-gradient(145deg, #ffffff 0%, #f7f6ff 100%);
  border: 1px solid var(--approach-border);
  border-radius: 22px;
  box-shadow: 0 8px 26px rgba(45, 48, 105, 0.045);
  transition:
    transform 240ms ease,
    box-shadow 240ms ease,
    border-color 240ms ease,
    background 240ms ease;
}

.process-card:hover,
.approach-card:hover {
  transform: translateY(-5px);
  border-color: #a9a1ff;
  background: linear-gradient(145deg, #ffffff 0%, #eeecff 100%);
  box-shadow: 0 18px 38px rgba(75, 65, 175, 0.12);
}

.process-card h3,
.approach-card h3 {
  color: var(--approach-ink);
}

.process-card p,
.approach-card p {
  color: #596681;
}

.process-card .eyebrow,
.approach-card .eyebrow {
  color: var(--approach-accent);
}

@media (prefers-reduced-motion: reduce) {
  .process-card,
  .approach-card {
    transition: none;
  }
}

/* WHY SECTION ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â PREMIUM COLOR REFINEMENT */
.why-section {
  background:
    radial-gradient(ellipse at 10% 0%, rgba(116, 105, 255, 0.10), transparent 42%),
    linear-gradient(145deg, #f2f1ff 0%, #f8f9ff 55%, #edf6ff 100%) !important;
}

.why-section .section-heading {
  color: #192544;
}

.why-section .section-heading .text-accent {
  color: #5145d9;
}

.why-section .section-copy {
  color: #586580;
}

.why-section .why-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff 0%, #f7f6ff 100%) !important;
  border: 1px solid #dedcff !important;
  border-radius: 22px;
  box-shadow: 0 8px 26px rgba(45, 48, 105, 0.055);
  transition: transform 240ms ease, box-shadow 240ms ease, border-color 240ms ease;
}

.why-section .why-card::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 4px;
  background: linear-gradient(180deg, #6457e8, #8bcbef);
  opacity: 0;
  transition: opacity 240ms ease;
}

.why-section .why-card:hover {
  transform: translateY(-5px);
  border-color: #aaa2ff !important;
  box-shadow: 0 18px 38px rgba(75, 65, 175, 0.13);
}

.why-section .why-card:hover::before {
  opacity: 1;
}

.why-section .why-card__number {
  color: #6457e8 !important;
  font-weight: 700;
}

.why-section .why-card h3 {
  color: #192544 !important;
}

.why-section .why-card p {
  color: #596681 !important;
  line-height: 1.75;
}

@media (prefers-reduced-motion: reduce) {
  .why-section .why-card,
  .why-section .why-card::before {
    transition: none;
  }
}
/* HERO LAYOUT REPAIR ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â PREVENT TEXT / CAROUSEL COLLISIONS */
.hero__content {
  grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr) !important;
  align-items: center;
  column-gap: clamp(24px, 3vw, 48px);
  padding-inline: clamp(24px, 3vw, 48px);
}

.hero__copy {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  z-index: 3;
}

.hero .hero-title--kinetic {
  max-width: 100%;
  font-size: clamp(2.7rem, 4.1vw, 4.4rem) !important;
  line-height: 1.04 !important;
  letter-spacing: -0.065em !important;
  overflow-wrap: normal;
  word-break: normal;
}

.hero .hero-title__line {
  max-width: 100%;
}

.hero__description {
  max-width: 540px;
  font-size: clamp(0.92rem, 1.05vw, 1.04rem);
  line-height: 1.7;
}

.hero__carousel,
.hero-visual--carousel {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  justify-self: stretch;
}

.hero-visual__frame {
  width: 100%;
  min-width: 0;
  aspect-ratio: 0.94 / 1;
}

.campaign-side-image {
  width: 30%;
  opacity: 0.55;
}

.campaign-side-image--previous {
  left: -12%;
}

.campaign-side-image--next {
  right: -12%;
}

@media (max-width: 1100px) {
  .hero__content {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr) !important;
    column-gap: 22px;
    padding-inline: 24px;
  }

  .hero .hero-title--kinetic {
    font-size: clamp(2.5rem, 4.4vw, 3.5rem) !important;
  }

  .campaign-side-image {
    width: 24%;
    opacity: 0.4;
  }

  .campaign-side-image--previous {
    left: -7%;
  }

  .campaign-side-image--next {
    right: -7%;
  }
}

@media (max-width: 760px) {
  .hero__content {
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 28px;
    padding-inline: 20px;
  }

  .hero .hero-title--kinetic {
    font-size: clamp(2.35rem, 8.5vw, 3.5rem) !important;
    line-height: 1.08 !important;
  }

  .hero__description {
    max-width: 100%;
  }

  .hero-visual--carousel {
    width: calc(100% - 24px);
    justify-self: center;
  }

  .campaign-side-image {
    width: 25%;
    opacity: 0.35;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero .hero-title--kinetic,
  .hero-visual__image {
    animation: none !important;
  }
}
/* HERO ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â REDUCE CAROUSEL FOOTPRINT */
.hero-visual--carousel {
  width: min(100%, 440px) !important;
  justify-self: center !important;
  margin-inline: auto;
}

.hero-visual__frame {
  aspect-ratio: 0.94 / 1;
  max-height: 470px;
}

.campaign-side-image {
  width: 24% !important;
  height: 84% !important;
  top: 8% !important;
  opacity: 0.35 !important;
}

.campaign-side-image--previous {
  left: -6% !important;
}

.campaign-side-image--next {
  right: -6% !important;
}

.hero__content {
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.82fr) !important;
  column-gap: clamp(20px, 3vw, 42px) !important;
}

@media (min-width: 1440px) {
  .hero-visual--carousel {
    width: min(100%, 470px) !important;
  }
}

@media (max-width: 760px) {
  .hero-visual--carousel {
    width: min(100%, 360px) !important;
  }

  .hero-visual__frame {
    max-height: none;
  }

  .campaign-side-image {
    width: 20% !important;
    opacity: 0.25 !important;
  }
}
/* DF HERO ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â CONSOLIDATED RESPONSIVE LAYOUT */
.hero__content {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.85fr);
  align-items: center;
  gap: clamp(24px, 3vw, 44px);
  min-height: 0;
  padding: clamp(48px, 6vw, 76px) 0;
}

.hero__copy {
  position: relative;
  z-index: 3;
  min-width: 0;
  max-width: 100%;
}

.hero .hero-title--kinetic {
  max-width: 100%;
  font-size: clamp(2.5rem, 4vw, 4.25rem) !important;
  line-height: 1.06 !important;
  letter-spacing: -0.055em !important;
}

.hero .hero-title__line,
.hero .hero-title__word {
  max-width: 100%;
}

.hero__description {
  max-width: 540px;
  font-size: clamp(0.9rem, 1vw, 1rem);
  line-height: 1.7;
}

.hero__actions {
  gap: 18px;
  margin-top: 26px;
}

.hero__carousel {
  min-width: 0;
  width: 100%;
  justify-self: center;
}

.hero-visual--carousel {
  width: min(100%, 400px) !important;
  max-width: 100%;
  margin-inline: auto;
}

.campaign-carousel__stage {
  position: relative;
  width: 100%;
  aspect-ratio: 0.94 / 1;
  max-height: 430px;
  overflow: visible !important;
  isolation: isolate;
  border-radius: 24px;
}

.campaign-carousel__stage .hero-visual__image {
  z-index: 2;
  border-radius: 24px;
  object-fit: cover;
}

.campaign-side-image {
  position: absolute;
  top: 8%;
  width: 25% !important;
  height: 84% !important;
  object-fit: cover;
  border-radius: 18px;
  opacity: 0.34;
  z-index: 1;
  pointer-events: none;
}

.campaign-side-image--previous {
  left: -6%;
}

.campaign-side-image--next {
  right: -6%;
}

.hero-visual__controls {
  position: relative;
  z-index: 4;
  margin-top: 14px;
}

@media (min-width: 1440px) {
  .hero-visual--carousel {
    width: min(100%, 430px) !important;
  }
}

@media (max-width: 1000px) {
  .hero__content {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 24px;
  }

  .hero .hero-title--kinetic {
    font-size: clamp(2.25rem, 4.2vw, 3.5rem) !important;
  }
}

@media (max-width: 760px) {
  .hero__content {
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;
    padding-block: 42px 32px;
  }

  .hero .hero-title--kinetic {
    font-size: clamp(2.25rem, 8vw, 3.25rem) !important;
    line-height: 1.08 !important;
  }

  .hero__description {
    max-width: 100%;
  }

  .hero-visual--carousel {
    width: min(100%, 340px) !important;
  }

  .campaign-side-image {
    opacity: 0.25;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-visual__image {
    animation: none !important;
  }
}

/* Consolidated header and hero spacing ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â replaces conflicting experimental overrides. */
.site-header {
  position: fixed;
  top: 12px;
  left: 50%;
  right: auto;
  transform: translateX(-50%);
  z-index: 1000;
  width: calc(100% - 48px);
  max-width: 1440px;
  margin: 0;
  box-sizing: border-box;
  border: 1px solid rgba(32, 37, 31, 0.12);
  border-radius: 18px;
  background: rgba(255, 254, 250, 0.94);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  box-shadow: 0 8px 28px rgba(23, 35, 59, 0.10);
  animation: none;
}

.site-header::before,
.site-header::after { display: none; }

.site-header__inner {
  width: min(calc(100% - 40px), 1340px);
  min-height: 76px;
  margin-inline: auto;
  gap: 24px;
}

.site-nav { gap: clamp(14px, 2vw, 28px); }
.site-nav__link { white-space: nowrap; }

.hero-scroll-scene { padding-top: 104px; }
.hero.section-shell { margin-top: 0; }
.hero { background: radial-gradient(circle at 78% 24%, rgba(87, 111, 255, 0.20), transparent 34%), linear-gradient(135deg, #101b35 0%, #17233b 58%, #202d4c 100%); animation: none; }
.hero__description { max-width: 590px; color: rgba(255, 255, 255, 0.78); }
.hero__actions { gap: 0; }

@media (max-width: 760px) {
  .site-header { top: 8px; width: calc(100% - 24px); border-radius: 14px; }
  .site-header__inner { width: calc(100% - 28px); min-height: 64px; gap: 12px; }
  .hero-scroll-scene { padding-top: 84px; }
}

@media (prefers-reduced-motion: reduce) {
  .site-header, .hero-title--kinetic .hero-title__word { animation: none !important; }
}

/* DF PREMIUM SCROLL + HERO + NAV POLISH v1 */
/* A restrained, consistent finish layered after the existing CSS. */

/* More intentional outer gutters and breathing room. */
.hero-scroll-scene {
  padding-top: 112px !important;
}

.hero.section-shell {
  width: 100%;
  overflow: clip;
}

.hero__content.container,
.hero__bottom.container {
  width: min(calc(100% - clamp(44px, 8vw, 136px)), 1480px) !important;
}

.hero__content.container {
  padding: clamp(44px, 5vw, 76px) clamp(8px, 1.5vw, 24px) !important;
  column-gap: clamp(28px, 4vw, 64px) !important;
}

.hero__copy {
  padding-block: clamp(8px, 1.2vw, 18px);
}

/* The supplied hero paragraph is deliberately one consistent near-white. */
.hero__description,
.hero__description--multicolor,
.hero__description--multicolor .hero__colored-word,
.hero__description--multicolor [class*="hero__colored-word--"] {
  color: #f5f7f3 !important;
  -webkit-text-fill-color: #f5f7f3 !important;
  opacity: 1 !important;
  text-shadow: 0 1px 14px rgb(7 14 12 / 16%);
}

.hero__description--multicolor {
  max-width: 610px !important;
  font-size: clamp(1rem, 1.08vw, 1.1rem) !important;
  line-height: 1.85 !important;
  letter-spacing: 0.005em;
}

/* Premium floating navigation: calmer glass, more room, no animated neon frame. */
.site-header {
  position: fixed !important;
  z-index: 1000 !important;
  top: 14px !important;
  left: 50% !important;
  right: auto !important;
  transform: translateX(-50%);
  width: calc(100% - clamp(56px, 10vw, 160px)) !important;
  max-width: 1480px !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: visible !important;
  isolation: isolate;
  border: 1px solid rgb(255 255 255 / 72%) !important;
  border-radius: 22px !important;
  background: rgb(250 251 248 / 88%) !important;
  background-image: none !important;
  backdrop-filter: blur(24px) saturate(145%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(145%) !important;
  box-shadow: 0 12px 34px rgb(18 28 22 / 11%), 0 2px 8px rgb(18 28 22 / 5%) !important;
  animation: none !important;
}

.site-header::before,
.site-header::after {
  display: none !important;
  animation: none !important;
}

.site-header__inner {
  width: 100% !important;
  max-width: none !important;
  min-height: 72px !important;
  padding-inline: clamp(18px, 2vw, 30px) !important;
  gap: clamp(14px, 2vw, 28px) !important;
}

.brand-lockup {
  flex-shrink: 0;
  gap: 12px !important;
}

.brand-mark {
  width: 44px !important;
  height: 44px !important;
  border-radius: 14px !important;
  box-shadow: 0 5px 12px rgb(32 37 31 / 13%);
}

.site-nav {
  align-items: center;
  gap: clamp(8px, 1.4vw, 22px) !important;
}

.site-nav__link {
  position: relative;
  padding: 10px 2px !important;
  color: #303a32 !important;
  font-size: 0.92rem !important;
  font-weight: 550 !important;
  letter-spacing: -0.01em;
  transition: color 180ms ease;
}

.site-nav__link::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 3px;
  left: 0;
  height: 1.5px;
  border-radius: 2px;
  background: #718b45;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 180ms ease;
}

.site-nav__link:hover,
.site-nav__link:focus-visible {
  color: #526b30 !important;
}

.site-nav__link:hover::after,
.site-nav__link:focus-visible::after {
  transform: scaleX(1);
}

.site-header .button--nav {
  min-height: 46px !important;
  padding: 0 20px !important;
  border: 1px solid rgb(32 37 31 / 8%) !important;
  border-radius: 999px !important;
  background: #20291f !important;
  color: #fff !important;
  box-shadow: 0 5px 12px rgb(32 41 31 / 14%);
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.site-header .button--nav:hover {
  transform: translateY(-1px);
  background: #34442b !important;
  box-shadow: 0 8px 18px rgb(32 41 31 / 18%);
}


/* Desktop sticky cards: preserve a natural stack and generous card spacing. */
@media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
  .services-section { position: relative; isolation: isolate; }

  .services-section .services-grid {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch;
    gap: 0 !important;
    padding: 10px 0 10vh;
  }

  .services-section .service-card {
    position: sticky;
    top: calc(112px + var(--stack-step, 0px));
    z-index: var(--stack-layer, 1);
    width: 100%;
    min-height: 245px;
    margin-bottom: 30vh;
    padding: clamp(28px, 3.4vw, 48px) !important;
    border: 1px solid rgb(32 37 31 / 11%) !important;
    border-radius: 26px !important;
    background: linear-gradient(135deg, #fffefa 0%, #f7f8f0 100%) !important;
    box-shadow: 0 18px 44px rgb(32 37 31 / 8%), 0 2px 6px rgb(32 37 31 / 3%) !important;
    transform-origin: top center;
    transition: border-color 220ms ease, box-shadow 220ms ease;
    scroll-margin-top: 124px;
  }

  .services-section .service-card:nth-child(1) { --stack-step: 0px; --stack-layer: 1; }
  .services-section .service-card:nth-child(2) { --stack-step: 10px; --stack-layer: 2; }
  .services-section .service-card:nth-child(3) { --stack-step: 20px; --stack-layer: 3; }
  .services-section .service-card:nth-child(4) { --stack-step: 30px; --stack-layer: 4; }
  .services-section .service-card:nth-child(5) { --stack-step: 40px; --stack-layer: 5; }
  .services-section .service-card:nth-child(6) { --stack-step: 50px; --stack-layer: 6; }
  .services-section .service-card:nth-child(7) { --stack-step: 60px; --stack-layer: 7; margin-bottom: 0; }

  .services-section .service-card:hover {
    border-color: rgb(113 139 69 / 55%) !important;
    box-shadow: 0 24px 58px rgb(32 37 31 / 12%), 0 3px 10px rgb(32 37 31 / 4%) !important;
  }

  .services-section .service-card__number {
    display: inline-flex;
    min-width: 42px;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(32 37 31 / 12%);
    border-radius: 50%;
    background: #f0f2e7;
    color: #526b30;
  }

  .services-section .service-card__body { max-width: 780px; padding-right: clamp(0px, 7vw, 100px); }
  .services-section .service-card h3 { max-width: 720px; font-size: clamp(1.55rem, 2.5vw, 2.35rem); line-height: 1.12; letter-spacing: -0.05em; }
  .services-section .service-card p { max-width: 720px; font-size: clamp(0.96rem, 1.1vw, 1.06rem); line-height: 1.8; }
  .services-section .service-card__cta { width: fit-content; padding-bottom: 4px; border-bottom: 1px solid rgb(82 107 48 / 38%); font-size: 0.88rem; }
}

@media (max-width: 899px), (prefers-reduced-motion: reduce) {
  .services-section .services-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 14px !important;
  }
  .services-section .service-card {
    position: relative !important;
    top: auto !important;
    z-index: auto !important;
    min-height: 240px;
    margin-bottom: 0 !important;
    transform: none;
  }
}

@media (max-width: 760px) {
  .hero-scroll-scene { padding-top: 88px !important; }
  .hero__content.container,
  .hero__bottom.container { width: calc(100% - 36px) !important; }
  .hero__content.container { padding: 38px 0 34px !important; gap: 30px !important; }

  .site-header {
    top: 8px !important;
    width: calc(100% - 24px) !important;
    border-radius: 17px !important;
  }
  .site-header__inner {
    min-height: 66px !important;
    padding-inline: 16px !important;
    gap: 12px !important;
  }
  .brand-mark { width: 39px !important; height: 39px !important; border-radius: 12px !important; }
  .site-nav {
    padding: 16px !important;
    border: 1px solid rgb(32 37 31 / 8%);
    border-radius: 18px;
    background: rgb(250 251 248 / 98%) !important;
    box-shadow: 0 18px 40px rgb(18 28 22 / 14%);
  }
  .site-header .button--nav { width: 100%; justify-content: center; }
}

@media (max-width: 600px) {
  .services-section .services-grid { grid-template-columns: minmax(0, 1fr) !important; gap: 12px !important; }
  .services-section .service-card { min-height: 220px; padding: 22px !important; border-radius: 20px !important; }
  .hero__description--multicolor { font-size: 1rem !important; line-height: 1.8 !important; }
}

@media (min-width: 761px) and (max-width: 1100px) {
  .site-header__inner { padding-inline: 24px !important; gap: 18px !important; }
  .site-nav { gap: 12px !important; }
  .site-nav__link { font-size: 0.86rem !important; }
  .site-header .button--nav { padding-inline: 15px !important; }
}

@media (prefers-reduced-motion: reduce) {
  .site-nav__link,
  .site-nav__link::after,
  .site-header .button--nav,
  .services-section .service-card { transition: none !important; }
}


/* DF HERO SPACING REFINEMENT - 2026-10-22 */
/* Improve the hero's outer frame, text/carousel balance, and responsive gutters. */
.hero-scroll-scene {
  padding-top: clamp(76px, 7vw, 104px) !important;
  padding-inline: clamp(12px, 2.2vw, 32px) !important;
  box-sizing: border-box !important;
}

.hero-scroll-scene__sticky {
  width: 100% !important;
  max-width: 1760px !important;
  margin-inline: auto !important;
}

.hero.section-shell {
  width: 100% !important;
  max-width: none !important;
  margin: 0 auto 30px !important;
  border-radius: clamp(22px, 2.5vw, 38px) !important;
  overflow: hidden !important;
}

.hero .hero__content {
  width: 100% !important;
  max-width: 1640px !important;
  box-sizing: border-box !important;
  margin-inline: auto !important;
  padding: clamp(64px, 7vw, 104px) clamp(32px, 5.4vw, 88px) clamp(58px, 6vw, 84px) !important;
  grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr) !important;
  column-gap: clamp(36px, 5vw, 80px) !important;
  align-items: center !important;
}

.hero .hero__copy {
  min-width: 0 !important;
  max-width: 690px !important;
}

.hero .hero-visual,
.hero .hero__carousel,
.hero .hero-visual__frame {
  max-width: 100% !important;
  min-width: 0 !important;
}

@media (max-width: 1100px) {
  .hero .hero__content {
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.9fr) !important;
    column-gap: 32px !important;
    padding-inline: clamp(28px, 4vw, 52px) !important;
  }
}

@media (max-width: 760px) {
  .hero-scroll-scene {
    padding-top: 78px !important;
    padding-inline: 10px !important;
  }
  .hero.section-shell {
    border-radius: 22px !important;
    margin-bottom: 20px !important;
  }
  .hero .hero__content {
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 30px !important;
    padding: 46px 24px 36px !important;
  }
  .hero .hero__copy {
    max-width: none !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-scroll-scene,
  .hero-scroll-scene__sticky {
    scroll-behavior: auto !important;
  }
}

/* Balanced hero frame and consistent left/right content gutters */
.hero-scroll-scene {
  box-sizing: border-box !important;
  padding-left: clamp(20px, 3.5vw, 56px) !important;
  padding-right: clamp(20px, 3.5vw, 56px) !important;
}

.hero-scroll-scene__sticky {
  width: 100% !important;
  max-width: 1600px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  box-sizing: border-box !important;
}

.hero.section-shell {
  width: 100% !important;
  max-width: none !important;
  margin-left: auto !important;
  margin-right: auto !important;
  box-sizing: border-box !important;
}

.hero__content.container,
.hero__bottom.container {
  width: calc(100% - clamp(40px, 7vw, 112px)) !important;
  max-width: 1440px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  box-sizing: border-box !important;
}

@media (max-width: 760px) {
  .hero-scroll-scene {
    padding-left: 12px !important;
    padding-right: 12px !important;
  }

  .hero__content.container,
  .hero__bottom.container {
    width: calc(100% - 32px) !important;
  }
}

/* Final hero gutter refinement */
.hero-scroll-scene {
  padding-left: clamp(28px, 4.5vw, 76px) !important;
  padding-right: clamp(28px, 4.5vw, 76px) !important;
}

.hero__content.container,
.hero__bottom.container {
  width: calc(100% - clamp(64px, 9vw, 144px)) !important;
  max-width: 1400px !important;
  margin-inline: auto !important;
}

@media (max-width: 760px) {
  .hero-scroll-scene {
    padding-inline: 14px !important;
  }

  .hero__content.container,
  .hero__bottom.container {
    width: calc(100% - 36px) !important;
  }
}

/* RISE 2-inspired navbar refinement: typography, active cue and hover motion */
.site-header__inner {
  gap: clamp(20px, 3vw, 48px) !important;
}

.site-nav {
  align-items: center !important;
  gap: clamp(18px, 2.05vw, 34px) !important;
}

.site-nav__link {
  position: relative !important;
  display: inline-flex !important;
  align-items: center !important;
  min-height: 42px !important;
  padding: 0 0 2px !important;
  color: #344052 !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  letter-spacing: -0.015em !important;
  text-decoration: none !important;
  transition: color 180ms ease, transform 180ms ease !important;
}

.site-nav__link::after {
  content: "" !important;
  position: absolute !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 3px !important;
  height: 2px !important;
  border-radius: 999px !important;
  background: #315efb !important;
  transform: scaleX(0) !important;
  transform-origin: left center !important;
  transition: transform 220ms cubic-bezier(.2,.7,.2,1) !important;
}

.site-nav__link:hover,
.site-nav__link:focus-visible {
  color: #17233b !important;
}

.site-nav__link:hover::after,
.site-nav__link:focus-visible::after {
  transform: scaleX(1) !important;
}

.site-nav__link:focus-visible {
  outline: 2px solid #315efb !important;
  outline-offset: 5px !important;
  border-radius: 3px !important;
}

.button--nav {
  min-height: 48px !important;
  padding: 0 24px !important;
  gap: 10px !important;
  font-size: 13px !important;
  font-weight: 650 !important;
  letter-spacing: -0.01em !important;
  box-shadow: 0 7px 18px rgba(18, 29, 48, .12) !important;
  transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease !important;
}

.button--nav:hover {
  transform: translateY(-1px) !important;
  box-shadow: 0 10px 24px rgba(18, 29, 48, .17) !important;
}

@media (max-width: 760px) {
  .site-nav {
    gap: 12px !important;
  }

  .site-nav__link {
    min-height: 40px !important;
  }

  .button--nav {
    min-height: 44px !important;
    padding-inline: 18px !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .site-nav__link,
  .site-nav__link::after,
  .button--nav {
    transition: none !important;
  }
}

/* PROCESS CARDS: HOVER-REVEAL SOFT COLOR REFINEMENT */
.approach-section .process-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 42px;
  align-items: stretch;
}

.approach-section .process-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 205px;
  padding: clamp(22px, 2.3vw, 32px);
  overflow: hidden;
  border: 1px solid rgba(35, 48, 67, 0.07);
  border-radius: 20px;
  background: #f7f4ec;
  box-shadow: 0 8px 26px rgba(25, 35, 48, 0.035);
  transition: transform 240ms ease, box-shadow 240ms ease, background-color 240ms ease, border-color 240ms ease;
}

.approach-section .process-card:nth-child(6n + 1) { background: #f5f1e8; }
.approach-section .process-card:nth-child(6n + 2) { background: #edf3f2; }
.approach-section .process-card:nth-child(6n + 3) { background: #f0eef8; }
.approach-section .process-card:nth-child(6n + 4) { background: #f8eee9; }
.approach-section .process-card:nth-child(6n + 5) { background: #eef2e8; }
.approach-section .process-card:nth-child(6n + 6) { background: #edf1f8; }

.approach-section .process-card__number {
  display: none !important;
}

.approach-section .process-card__rule {
  width: 34px;
  flex: 0 0 auto;
  margin: 0 0 24px;
  background: rgba(35, 48, 67, 0.22);
  transition: width 240ms ease, background-color 240ms ease;
}

.approach-section .process-card h3 {
  margin: 0;
  color: #1c2636;
  font-size: clamp(1.2rem, 1.55vw, 1.45rem);
  font-weight: 650;
  letter-spacing: -0.04em;
  line-height: 1.2;
}

.approach-section .process-card p {
  max-width: 32ch;
  margin: 12px 0 0;
  color: #515b69;
  font-size: 0.91rem;
  line-height: 1.7;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transform: translateY(8px);
  transition: opacity 220ms ease, transform 220ms ease, max-height 260ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .approach-section .process-card:hover {
    transform: translateY(-4px);
    border-color: rgba(35, 48, 67, 0.13);
    box-shadow: 0 16px 34px rgba(25, 35, 48, 0.09);
  }

  .approach-section .process-card:hover .process-card__rule {
    width: 54px;
    background: #6279d8;
  }

  .approach-section .process-card:hover p {
    opacity: 1;
    max-height: 180px;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .approach-section .process-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .approach-section .process-card {
    min-height: 190px;
  }

  .approach-section .process-card p {
    opacity: 1;
    max-height: 220px;
    transform: none;
  }
}

@media (max-width: 560px) {
  .approach-section .process-grid {
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 30px;
  }

  .approach-section .process-card {
    min-height: auto;
    padding: 24px;
  }

  .approach-section .process-card p {
    max-width: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .approach-section .process-card,
  .approach-section .process-card__rule,
  .approach-section .process-card p {
    transition: none !important;
  }
}

/* CRYSTALIZED SERVICE ORBS */
.services-section .services-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(16px, 2vw, 26px);
  align-items: stretch;
}

.services-section .service-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 390px;
  padding: 22px 24px 24px;
  overflow: hidden;
  border: 1px solid rgba(92, 101, 125, 0.14);
  border-radius: 26px;
  background: linear-gradient(160deg, rgba(255,255,255,0.98), rgba(247,247,251,0.94));
  box-shadow: 0 10px 34px rgba(29, 36, 58, 0.055);
  transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease;
}

.services-section .service-card::before { content: none; }

.services-section .service-card__orb {
  position: relative;
  width: 100%;
  height: 176px;
  margin: 0 auto 8px;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 20px;
  background: radial-gradient(ellipse at center, rgba(237, 234, 255, 0.72), rgba(249, 249, 252, 0) 72%);
}

.services-section .service-card__orb .crystalized-ball { width: 100%; height: 100%; }

.services-section .service-card__top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.services-section .service-card__number { display: none; }

.services-section .service-card__tag {
  border: 1px solid rgba(96, 105, 135, 0.14);
  background: rgba(255, 255, 255, 0.78);
  color: #535c70;
}

.services-section .service-card__body { position: relative; z-index: 1; margin-top: 14px; padding: 0; }

.services-section .service-card__body h3 {
  color: #20283a;
  font-size: clamp(1.12rem, 1.4vw, 1.35rem);
  line-height: 1.25;
  letter-spacing: -0.035em;
}

.services-section .service-card__body p {
  max-height: none;
  margin-top: 10px;
  color: #5a6373;
  font-size: 0.9rem;
  line-height: 1.7;
  opacity: 1;
  transform: none;
}

.services-section .service-card__cta {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
  padding-top: 18px;
  color: #343d55;
  font-size: 0.84rem;
  font-weight: 650;
}

.services-section .service-card:hover,
.services-section .service-card:focus-visible {
  transform: translateY(-5px);
  border-color: rgba(112, 103, 190, 0.3);
  box-shadow: 0 20px 46px rgba(29, 36, 58, 0.12);
}

.services-section .service-card:focus-visible { outline: 3px solid rgba(112, 103, 190, 0.42); outline-offset: 3px; }

@media (max-width: 980px) {
  .services-section .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .services-section .service-card { min-height: 370px; }
}

@media (max-width: 620px) {
  .services-section .services-grid { grid-template-columns: 1fr; }
  .services-section .service-card { min-height: 0; padding: 20px 22px 22px; }
  .services-section .service-card__orb { height: 190px; }
}

@media (prefers-reduced-motion: reduce) {
  .services-section .service-card { transition: none; }
}


/* Crystal service orbs ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â replace rectangular service cards with immersive spheres. */
.services-section .services-grid.services-orbit-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: start;
  gap: clamp(20px, 3vw, 42px);
  margin-top: clamp(34px, 5vw, 66px);
}

.services-section .service-card.service-orb {
  position: relative;
  display: grid;
  place-items: center;
  justify-self: center;
  width: min(100%, 340px);
  min-width: 0;
  min-height: 0 !important;
  aspect-ratio: 1 / 1;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 50%;
  isolation: isolate;
  background:
    radial-gradient(circle at 50% 35%, rgba(111, 97, 202, .14), transparent 60%),
    #10111b;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.16), 0 20px 60px rgba(24, 24, 46, .16);
  text-align: center;
  text-decoration: none;
  transform: translateZ(0);
  transition: transform 300ms ease, box-shadow 300ms ease;
}

.services-section .service-orb::before {
  content: "";
  position: absolute;
  inset: 7px;
  z-index: 2;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 50%;
  pointer-events: none;
}

.services-section .service-orb:hover,
.services-section .service-orb:focus-visible {
  transform: translateY(-7px) scale(1.025);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.26), 0 28px 72px rgba(45, 35, 91, .28);
}

.services-section .service-orb__visual {
  position: absolute;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  border-radius: 50%;
  opacity: .9;
}

.services-section .service-orb__visual .crystalized-ball {
  display: block;
  width: 100%;
  height: 100%;
}

.services-section .service-orb__visual canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.services-section .service-orb__content {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: clamp(26px, 3vw, 38px);
  color: #fff;
  background: radial-gradient(ellipse at center, rgba(12, 13, 23, .70) 0%, rgba(12, 13, 23, .42) 54%, rgba(12, 13, 23, .08) 100%);
  border-radius: 50%;
}

.services-section .service-orb__eyebrow {
  margin-bottom: 12px;
  color: rgba(255,255,255,.76);
  font-size: .67rem;
  font-weight: 750;
  letter-spacing: .17em;
  text-transform: uppercase;
}

.services-section .service-orb__title {
  display: block;
  max-width: 245px;
  color: #fff;
  font-size: clamp(1.18rem, 1.65vw, 1.58rem);
  font-weight: 720;
  line-height: 1.12;
  letter-spacing: -.045em;
  text-wrap: balance;
}

.services-section .service-orb__description {
  display: block;
  max-width: 245px;
  margin-top: 12px;
  color: rgba(255,255,255,.82);
  font-size: clamp(.72rem, .9vw, .83rem);
  line-height: 1.55;
}

.services-section .service-orb__cta {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 16px;
  color: #e3dcff;
  font-size: .75rem;
  font-weight: 700;
}

.services-section .service-orb__cta span { transition: transform 180ms ease; }
.services-section .service-orb:hover .service-orb__cta span { transform: translate(3px, -3px); }
.services-section .service-orb:focus-visible { outline: 3px solid #a99cff; outline-offset: 5px; }

/* Section-to-section depth: subtle overlap keeps the page feeling like a stack
   without pinning long content or interfering with the existing hero scene. */
@media (min-width: 981px) {
  main#main-content > .scroll-stack-section {
    position: relative;
    isolation: isolate;
    border-radius: 28px 28px 0 0;
    box-shadow: 0 -10px 34px rgba(22, 27, 45, .035);
  }
  main#main-content > .scroll-stack-section:nth-of-type(2) { z-index: 2; }
  main#main-content > .scroll-stack-section:nth-of-type(3) { z-index: 3; }
  main#main-content > .scroll-stack-section:nth-of-type(4) { z-index: 4; }
  main#main-content > .scroll-stack-section:nth-of-type(5) { z-index: 5; }
  main#main-content > .scroll-stack-section:nth-of-type(6) { z-index: 6; }
  main#main-content > .scroll-stack-section:nth-of-type(7) { z-index: 7; }
  main#main-content > .scroll-stack-section:nth-of-type(8) { z-index: 8; }
  main#main-content > .scroll-stack-section:nth-of-type(9) { z-index: 9; }
  main#main-content > .scroll-stack-section:nth-of-type(10) { z-index: 10; }
  main#main-content > .scroll-stack-section + .scroll-stack-section { margin-top: -12px; }
}

@media (max-width: 980px) {
  .services-section .services-grid.services-orbit-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }
  .services-section .service-card.service-orb { width: min(100%, 320px); }
  .services-section .service-orb__content { padding: 28px; }
  .services-section .service-orb__description { font-size: .78rem; }
}

@media (max-width: 620px) {
  .services-section .services-grid.services-orbit-grid { grid-template-columns: 1fr; gap: 24px; }
  .services-section .service-card.service-orb { width: min(88vw, 340px); }
  .services-section .service-orb__title { font-size: 1.35rem; }
  .services-section .service-orb__description { font-size: .82rem; }
  main#main-content > .scroll-stack-section { border-radius: 20px 20px 0 0; }
  main#main-content > .scroll-stack-section + .scroll-stack-section { margin-top: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .services-section .service-card.service-orb,
  .services-section .service-orb__cta span { transition: none !important; }
}

/* CRYSTAL SERVICE REFINEMENT ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â targeted class-name fix */
.services-section .crystal-services-grid {
  display: grid;
