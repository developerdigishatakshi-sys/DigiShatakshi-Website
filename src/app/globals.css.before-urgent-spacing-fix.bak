}

.why-section .why-grid > .why-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px rgba(30, 32, 48, 0.10);
}

/* Final homepage star system */
.hero {
  position: relative;
  isolation: isolate;
}

.hero .hero-falling-stars--page {
  position: absolute;
  inset: 0;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
}

.hero .hero__content,
.hero .hero__bottom {
  position: relative;
  z-index: 2;
}

.hero .hero-falling-star {
  position: absolute;
  top: -8%;
  left: var(--star-left, 4%);
  display: block;
  width: 2px;
  height: var(--star-length, 64px);
  border-radius: 999px;
  opacity: 0;
  background: linear-gradient(
    to bottom,
    transparent,
    var(--star-color),
    #fff
  );
  box-shadow: 0 0 8px var(--star-glow);
  transform: rotate(38deg);
  transform-origin: center top;
  animation: hero-star-drift var(--star-duration, 5s) linear
    var(--star-delay, 0s) infinite;
}

.hero .hero-falling-star--0 {
  --star-color: #37e58a;
  --star-glow: rgba(55, 229, 138, .8);
}
.hero .hero-falling-star--1 {
  --star-color: #ff5b68;
  --star-glow: rgba(255, 91, 104, .8);
}
.hero .hero-falling-star--2 {
  --star-color: #58a6ff;
  --star-glow: rgba(88, 166, 255, .85);
}
.hero .hero-falling-star--3 {
  --star-color: #e6edf7;
  --star-glow: rgba(230, 237, 247, .9);
  width: 1.5px;
}

/* Spread the regular stars across the hero, beginning on the left. */
.hero .hero-falling-star:nth-child(1)  { --star-left: 3%;  --star-delay: -1s;   --star-duration: 5.5s; }
.hero .hero-falling-star:nth-child(2)  { --star-left: 12%; --star-delay: -3.2s; --star-duration: 4.7s; }
.hero .hero-falling-star:nth-child(3)  { --star-left: 21%; --star-delay: -2.4s; --star-duration: 5.8s; }
.hero .hero-falling-star:nth-child(4)  { --star-left: 30%; --star-delay: -4.1s; --star-duration: 5.1s; }
.hero .hero-falling-star:nth-child(5)  { --star-left: 39%; --star-delay: -1.8s; --star-duration: 6s; }
.hero .hero-falling-star:nth-child(6)  { --star-left: 48%; --star-delay: -3.7s; --star-duration: 5.3s; }
.hero .hero-falling-star:nth-child(7)  { --star-left: 57%; --star-delay: -.7s;  --star-duration: 4.8s; }
.hero .hero-falling-star:nth-child(8)  { --star-left: 66%; --star-delay: -2.9s; --star-duration: 5.6s; }
.hero .hero-falling-star:nth-child(9)  { --star-left: 75%; --star-delay: -4.5s; --star-duration: 5s; }
.hero .hero-falling-star:nth-child(10) { --star-left: 84%; --star-delay: -1.4s; --star-duration: 5.7s; }
.hero .hero-falling-star:nth-child(11) { --star-left: 93%; --star-delay: -3.4s; --star-duration: 4.9s; }

/* Shooting stars: brighter, longer trails, faster diagonal movement. */
.hero .hero-falling-star--shooting {
  width: 3px;
  height: 110px;
  box-shadow: 0 0 10px var(--star-glow), 0 0 22px var(--star-glow);
  animation-name: hero-shooting-star;
  animation-duration: 2.1s;
}

.hero .hero-falling-star--shooting:nth-child(1)  { --star-left: 2%;  --star-delay: -1.2s; }
.hero .hero-falling-star--shooting:nth-child(8)  { --star-left: 8%;  --star-delay: -2.6s; }
.hero .hero-falling-star--shooting:nth-child(15) { --star-left: 15%; --star-delay: -.4s; }
.hero .hero-falling-star--shooting:nth-child(22) { --star-left: 4%;  --star-delay: -3.8s; }

@keyframes hero-star-drift {
  0% {
    opacity: 0;
    transform: translate3d(-20px, -10%, 0) rotate(38deg);
  }
  15% { opacity: .8; }
  70% { opacity: .65; }
  100% {
    opacity: 0;
    transform: translate3d(120px, 110vh, 0) rotate(38deg);
  }
}

@keyframes hero-shooting-star {
  0% {
    opacity: 0;
    transform: translate3d(-80px, -15%, 0) rotate(38deg) scaleY(.65);
  }
  12% { opacity: 1; }
  72% { opacity: .9; }
  100% {
    opacity: 0;
    transform: translate3d(260px, 85vh, 0) rotate(38deg) scaleY(1.2);
  }
}

@media (max-width: 760px) {
  .hero .hero-falling-star--shooting {
    animation-duration: 2.8s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero .hero-falling-stars--page {
    display: none;
  }
}

/* Final navbar styling and scroll states */
.site-header {
