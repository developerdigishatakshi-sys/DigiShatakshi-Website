/* Active service only: hide illustrations belonging to inactive cards */
@media (min-width: 761px) {
  .services-section .crystal-service:not(:has(.seo-word-typing[aria-hidden="false"]))
    .crystal-service__side-images {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .services-section .crystal-service:has(.seo-word-typing[aria-hidden="false"])
    .crystal-service__side-images {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: none !important;
    transition: opacity 250ms ease, visibility 250ms ease;
  }
}



/* Final fix: move side artwork outward without vertical movement */
@media (min-width: 1101px) {
  .services-section .crystal-service__side-images {
    position: absolute !important;
    inset: 0 !important;
    overflow: visible !important;
  }

  .services-section .crystal-service__image--left {
    left: 0 !important;
    right: auto !important;
    top: 50% !important;
    transform: translate(-12%, -50%) !important;
  }

  .services-section .crystal-service__image--right {
    right: 0 !important;
    left: auto !important;
    top: 50% !important;
    transform: translate(12%, -50%) !important;
  }
}