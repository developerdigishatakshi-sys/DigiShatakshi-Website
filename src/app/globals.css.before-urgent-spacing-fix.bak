    max-height: none;
    border-radius: 20px;
  }
}

/* DIGI STAKSHI ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â graphics performance refinement */
@media (prefers-reduced-motion: reduce) {
  .hero-falling-stars--page,
  .hero-falling-stars--page *,
  .hero__ambient,
  .hero__orb--one,
  .hero__orb--two {
    animation: none !important;
    transition: none !important;
  }
}

/* Keep the hero atmosphere lightweight during scrolling. */
.hero .hero-falling-stars--page {
  pointer-events: none;
  contain: paint;
}

.hero .hero__ambient {
  pointer-events: none;
}

/* Avoid animating expensive shadows and filters on decorative hero layers. */
.hero .hero__orb--one,
.hero .hero__orb--two {
  filter: none !important;
  box-shadow: none !important;
}


